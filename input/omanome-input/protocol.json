{
  "protocol": "omanome-input",
  "version": 1,
  "transport": "newline-delimited-json",
  "correlation": {
    "session": "required opaque helper-instance token on every emitted event",
    "requestId": "shell-assigned numeric command correlation on ACK-capable commands"
  },
  "limits": {
    "maxCommandBytes": 16384,
    "maxTextBytes": 4096,
    "maxPendingCommands": 256,
    "maxSurroundingTextBytes": 4096
  },
  "commands": [
    "input.status",
    "input.capabilities",
    "set.language",
    "keyboard.layout",
    "keyboard.text",
    "text.commit",
    "keyboard.key",
    "keyboard.modifiers",
    "keyboard.reset",
    "text.delete",
    "text.state",
    "shutdown"
  ],
  "events": [
    "input.status",
    "input.capabilities",
    "input.error",
    "input.ack",
    "text.enter",
    "text.leave",
    "text.state",
    "osk.request",
    "tablet.event"
  ],
  "privacy": {
    "typedTextEmitted": false,
    "surroundingTextEmitted": false,
    "passwordPayloadPersisted": false,
    "argvPayloadsAllowed": false,
    "hardwareIdentifiersEmitted": false
  },
  "tablet": {
    "protocol": "zwp_tablet_v2",
    "events": ["proximity", "motion", "tip", "pressure", "tilt", "distance", "rotation", "button", "frame"],
    "normalizedAxes": {"pressure": [0, 65535], "distance": [0, 65535]},
    "hardwareSerials": "redacted",
    "provider": "native-wayland-only"
  },
  "fallback": {
    "nativeVirtualKeyboard": "runtime-probe",
    "wtype": "explicit-shell-owned-fallback",
    "unknown": "unavailable"
  },
  "textFocus": {
    "provider": "zwp_input_method_v2",
    "textInput": "zwp_text_input_v3-capability-probe",
    "recognition": "unavailable-until-provider-selected"
  }
}
