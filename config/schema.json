{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omanome.dev/schema/config-v2.json",
  "title": "Omanome configuration",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "general": { "type": "object" },
    "appearance": { "type": "object" },
    "controlCenter": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "masterEnabled": { "type": "boolean" },
        "suspended": { "type": "boolean" },
        "widget": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "position": { "enum": ["left", "center", "right"] },
            "clickAction": { "type": "string" },
            "rightClickAction": { "type": "string" },
            "longPressAction": { "type": "string" },
            "showLabel": { "type": "boolean" }
          }
        },
        "compactToggles": { "type": "array", "items": { "type": "string" } },
        "visibleModules": { "type": "array", "items": { "type": "string" } },
        "moduleOrder": { "type": "array", "items": { "type": "string" } },
        "osd": { "type": "object" }
      }
    },
    "adaptive": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "profile": { "enum": ["auto", "desktop", "tablet", "hybrid", "presentation", "gaming", "custom"] },
        "automaticTransitions": { "type": "boolean" },
        "externalKeyboardPolicy": { "enum": ["nothing", "hide-osk", "hybrid", "desktop", "ask"] },
        "unknownKeyboardPolicy": { "enum": ["ignore", "generic", "hybrid", "desktop", "ask"] },
        "transition": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "debounceMs": { "type": "integer", "minimum": 20, "maximum": 1500 },
            "stabilityMs": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 1500 },
            "oskPolicy": { "type": "string" },
            "showOsd": { "type": "boolean" },
            "animationPreset": { "enum": ["smooth", "snappy", "minimal"] }
          }
        },
        "profiles": {
          "type": "object",
          "properties": {
            "auto": { "$ref": "#/$defs/profile" },
            "desktop": { "$ref": "#/$defs/profile" },
            "tablet": { "$ref": "#/$defs/profile" },
            "hybrid": { "$ref": "#/$defs/profile" },
            "presentation": { "$ref": "#/$defs/profile" },
            "gaming": { "$ref": "#/$defs/profile" },
            "custom": { "$ref": "#/$defs/profile" }
          }
        },
        "deviceRules": { "type": "array" },
        "dockedMode": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "trigger": { "enum": ["external-monitor-and-keyboard", "external-monitor"] },
            "profile": { "enum": ["desktop", "tablet", "hybrid"] },
            "keepTouch": { "type": "boolean" },
            "restoreAutoState": { "type": "boolean" },
            "rotation": { "enum": ["preserve", "auto", "locked", "unchanged"] },
            "debounceMs": { "type": "integer", "minimum": 80, "maximum": 1500 },
            "stabilityMs": { "type": "integer", "minimum": 0, "maximum": 1500 }
          }
        }
      }
    },
    "tabletMode": { "type": "object" },
    "input": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "nativeBackend": { "enum": ["auto", "native", "fallback", "disabled"] },
        "allowWtypeFallback": { "type": "boolean" },
        "suppressOskOnPhysicalKeyboard": { "type": "boolean" },
        "suppressOskOnDetachableKeyboard": { "type": "boolean" },
        "suppressOskOnBluetoothKeyboard": { "type": "boolean" },
        "deviceHotplug": { "type": "boolean" },
        "safeModeDisableNative": { "type": "boolean" },
        "defaultOutput": { "type": "string" },
        "deviceMappings": { "type": "object" }
      }
    },
    "deviceProfiles": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 2 },
        "enabled": { "type": "boolean" },
        "profiles": { "type": "object", "maxProperties": 256 },
        "rules": { "type": "array", "maxItems": 128 },
        "calibrations": {
          "type": "object",
          "properties": {
            "schemaVersion": { "const": 1 },
            "entries": {
              "type": "object",
              "maxProperties": 256,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "schemaVersion": { "const": 1 },
                  "id": { "type": "string", "maxLength": 80 },
                  "kind": { "enum": ["touchscreen", "stylus"] },
                  "deviceId": { "type": "string" },
                  "outputId": { "type": "string" },
                  "mapping": { "type": "object" },
                  "lastKnownGood": { "type": ["object", "null"] },
                  "lastKnownGoodAt": { "type": "integer", "minimum": 0 },
                  "status": { "enum": ["last-known-good", "confirmed"] },
                  "revision": { "type": "integer", "minimum": 0 },
                  "updatedAt": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "revision": { "type": "integer", "minimum": 0 }
          }
        },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "hardwareSetupProfiles": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "selected": { "enum": ["auto", "tablet", "desk", "portable", "travel", "presentation", "drawing", "custom"] },
        "profiles": { "type": "object", "maxProperties": 12 },
        "displayPolicy": {
          "type": "object",
          "properties": {
            "schemaVersion": { "const": 1 },
            "primaryDisplay": { "type": "string" },
            "oskTarget": { "enum": ["focused-display", "primary-touch", "ask", "disabled"] },
            "roles": { "type": "object", "maxProperties": 256 }
          }
        },
        "matchPolicy": {
          "type": "object",
          "properties": {
            "schemaVersion": { "const": 1 },
            "mode": { "enum": ["ask", "auto-apply", "manual"] },
            "autoApply": { "type": "boolean" },
            "promptOnce": { "type": "boolean" }
          }
        },
        "matches": { "type": "array", "maxItems": 32 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "calibration": {
      "type": "object",
      "properties": {
        "confirmationTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 15000 },
        "autoRollback": { "type": "boolean" },
        "preserveLastKnownGood": { "type": "boolean" },
        "safeModeIgnoreCustom": { "type": "boolean" }
      }
    },
    "onboarding": { "type": "object" },
    "accessibility": { "type": "object" },
    "touch": { "type": "object" },
    "stylus": { "type": "object" },
    "windowControls": { "type": "object" },
    "quickSettings": { "type": "object" },
    "dock": { "type": "object" },
    "overview": { "type": "object" },
    "launcher": { "type": "object" },
    "multitasking": { "type": "object" },
    "keyboard": { "type": "object" },
    "clipboard": { "type": "object" },
    "notifications": { "type": "object" },
    "altTab": { "type": "object" },
    "blur": { "type": "object" },
    "effects": { "type": "object" },
    "animations": { "type": "object" },
    "performance": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["automatic", "quality", "balanced", "performance", "battery-saver"] },
        "qualityPreset": { "enum": ["automatic", "quality", "balanced", "performance", "battery-saver"] },
        "adaptiveQuality": { "type": "boolean" },
        "highGpuThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "gpuLoadSource": { "type": "string" },
        "disableOnBattery": { "type": "boolean" },
        "disableOnFullscreen": { "type": "boolean" },
        "fullscreenPolicy": { "enum": ["quality", "balanced", "performance", "battery-saver"] },
        "autoDisableOnFrameBudget": { "type": "boolean" }
      }
    },
    "applicationRules": { "type": "object" },
    "wobbly": { "type": "object" },
    "cube": { "type": "object" },
    "forceQuit": { "type": "object" },
    "rotation": {
      "type": "object",
      "properties": {
        "orientationDebounceMs": { "type": "integer", "minimum": 120, "maximum": 5000 },
        "minimumDwellMs": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "privacy": { "type": "object" },
    "shortcuts": { "type": "object" },
    "updates": { "type": "object" },
    "recovery": { "type": "object" },
    "diagnostics": { "type": "object" }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["auto", "desktop", "tablet", "hybrid"] },
        "featureOverrides": { "type": "object" },
        "componentBehavior": { "type": "object" }
      }
    }
  },
  "additionalProperties": true
}
