{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omanome.dev/schema/config-v2.json",
  "title": "Omanome configuration",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "general": { "type": "object" },
    "appearance": { "type": "object" },
    "tabletMode": { "type": "object" },
    "onboarding": { "type": "object" },
    "accessibility": { "type": "object" },
    "touch": { "type": "object" },
    "stylus": { "type": "object" },
    "windowControls": { "type": "object" },
    "quickSettings": { "type": "object" },
    "dock": { "type": "object" },
    "overview": { "type": "object" },
    "launcher": { "type": "object" },
    "keyboard": { "type": "object" },
    "clipboard": { "type": "object" },
    "notifications": { "type": "object" },
    "altTab": { "type": "object" },
    "blur": { "type": "object" },
    "effects": { "type": "object" },
    "animations": { "type": "object" },
    "performance": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["balanced", "performance", "battery-saver"] },
        "qualityPreset": { "enum": ["quality", "balanced", "performance", "battery-saver"] },
        "adaptiveQuality": { "type": "boolean" },
        "highGpuThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "gpuLoadSource": { "type": "string" },
        "disableOnBattery": { "type": "boolean" },
        "disableOnFullscreen": { "type": "boolean" },
        "fullscreenPolicy": { "enum": ["balanced", "performance", "battery-saver"] },
        "autoDisableOnFrameBudget": { "type": "boolean" }
      }
    },
    "applicationRules": { "type": "object" },
    "wobbly": { "type": "object" },
    "cube": { "type": "object" },
    "forceQuit": { "type": "object" },
    "rotation": { "type": "object" },
    "privacy": { "type": "object" },
    "shortcuts": { "type": "object" },
    "updates": { "type": "object" },
    "recovery": { "type": "object" },
    "diagnostics": { "type": "object" }
  },
  "additionalProperties": true
}
