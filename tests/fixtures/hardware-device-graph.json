{
  "schemaVersion": 1,
  "name": "docked-tablet-device-graph",
  "monitors": [
    {
      "name": "Internal Panel",
      "builtin": true,
      "role": "internal",
      "geometry": {"x": 0, "y": 0, "width": 1920, "height": 1080},
      "scale": 1.5,
      "orientation": "normal"
    },
    {
      "name": "Desk Display",
      "external": true,
      "role": "external",
      "geometry": {"x": 1920, "y": 0, "width": 2560, "height": 1440},
      "scale": 1.25,
      "orientation": "normal"
    }
  ],
  "devices": [
    {
      "stableId": "touch-panel",
      "type": "touchscreen",
      "serial": "SERIAL-DEVICE-CHECK",
      "address": "aa:bb:cc:dd:ee:ff",
      "path": "/sys/devices/private/input/event42",
      "capabilities": {"touchscreen": true, "multitouch": true, "absolute": true},
      "output": "Internal Panel",
      "connected": true
    },
    {
      "stableId": "pen-input",
      "type": "stylus",
      "capabilities": {"stylus": true, "pressure": true, "tilt-x": true, "tilt-y": true, "proximity": true},
      "connected": true
    },
    {
      "stableId": "desk-dock",
      "type": "dock",
      "transport": "usb-c",
      "connected": true
    },
    {
      "stableId": "desk-keyboard",
      "type": "keyboard",
      "transport": "usb",
      "formFactorRole": "external",
      "capabilities": {"keyboard": true},
      "connected": true
    }
  ],
  "relationships": [
    {"from": "desk-keyboard", "to": "desk-dock", "type": "attached-to", "confidence": "confirmed"},
    {"from": "pen-input", "to": "desk-dock", "type": "attached-to", "confidence": "probable"},
    {"from": "touch-panel", "to": "desk-dock", "type": "attached-to", "confidence": "unknown"}
  ],
  "scenarios": {
    "graph": true,
    "mapping": true,
    "calibrationRollback": true,
    "eventCoalescing": true,
    "privacy": true,
    "stylus": true,
    "multiMonitor": true,
    "rotation": true
  }
}
