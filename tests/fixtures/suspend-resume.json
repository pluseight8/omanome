{
  "schemaVersion": 1,
  "wayland": true,
  "hyprland": true,
  "display": [{ "name": "eDP-1" }, { "name": "DP-1" }],
  "keyboard": [{ "type": "keyboard" }],
  "detachableKeyboard": { "available": true, "transport": "bluetooth" },
  "multitouch": { "available": true, "maxContacts": 10 },
  "orientation": { "available": true, "source": "fixture" },
  "osk": { "available": true, "autoShow": true },
  "multiMonitor": { "available": true },
  "devices": {
    "touch": [{ "type": "touchscreen" }],
    "tablets": [{ "type": "tablet-tool", "capabilities": ["pressure", "proximity"] }]
  },
  "events": [
    { "type": "device.event", "action": "add", "subsystem": "drm" },
    { "type": "device.event", "action": "remove", "subsystem": "input" }
  ],
  "suspendResume": {
    "events": [
      { "event": "suspend" },
      { "event": "resume" }
    ]
  },
  "waylandReconnect": true,
  "outputMapping": {
    "device": "tablet-tool-0",
    "configuredOutput": "eDP-1",
    "fallbackOutput": "DP-1"
  },
  "rollback": { "reason": "rotation-transaction-failed", "restored": true },
  "handwriting": { "ink": true, "recognition": "unavailable", "cloud": false }
}
