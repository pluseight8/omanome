    --argjson devices "$safe" \
    --argjson native "$native" \
    '{schemaVersion:1,nativeBackend:($native.nativeBackend // {status:"unavailable"}),protocolSupport:($native.protocolSupport // {}),touchscreen:($native.touchscreen // {count:0}),touchDevices:($devices.touchDevices // []),modeReasoning:{touchscreenDetected:(($native.touchscreen.count // 0) > 0),physicalKeyboardDetected:($native.physicalKeyboard.detected // false),reason:(if (($native.touchscreen.count // 0) == 0) then "no touchscreen capability reported" elif ($native.physicalKeyboard.detected // false) then "touchscreen present; physical keyboard also detected" else "touchscreen present without physical keyboard" end)},privacy:(($native.privacy // {}) + {hardwareIdentifiersEmitted:false,typedTextLogged:false,surroundingTextPersisted:false,serialsEmitted:false,bluetoothMacEmitted:false})}'
}

sensor_info_cmd() {
  [[ -x "$repo_dir/input/sensor-info.sh" ]] || die "sensor-info backend is unavailable"
  local sensor='{}' defaults='{}'
  sensor="$("$repo_dir/input/sensor-info.sh" 2>/dev/null || printf '{}')"
  defaults="$(jq -c '.rotation // {}' "$repo_dir/config/defaults.json" 2>/dev/null || printf '{}')"
  jq -e . >/dev/null 2>&1 <<<"$sensor" || sensor='{}'
  jq -e . >/dev/null 2>&1 <<<"$defaults" || defaults='{}'
  jq -n \
    --argjson sensor "$sensor" \
    --argjson defaults "$defaults" \
    '$sensor + {schemaVersion:1,rotationPolicy:{orientationDebounceMs:($defaults.orientationDebounceMs // 550),minimumDwellMs:($defaults.minimumDwellMs // 1000)},privacy:{sensorPayloadLogged:false}}'
}

effects_cmd() {
  [[ -x "$repo_dir/input/effects-info.sh" ]] || die "effect diagnostics are unavailable"
  "$repo_dir/input/effects-info.sh" | jq .
}

capabilities_cmd() {
  local hardware='{}' effects='{}' sensors='{}' companion='{}' system='{}' input='{}'
  hardware="$(python3 "$repo_dir/scripts/hardware_test.py" --json 2>/dev/null || printf '{}')"
  effects="$("$repo_dir/input/effects-info.sh" 2>/dev/null || printf '{}')"
  sensors="$("$repo_dir/input/sensor-info.sh" 2>/dev/null || printf '{}')"
  companion="$("$repo_dir/input/companion-info.sh" 2>/dev/null || printf '{}')"
  system="$("$repo_dir/input/system-state.sh" 2>/dev/null || printf '{}')"
  input="$(input_info_cmd 2>/dev/null || printf '{}')"
  for value in hardware effects sensors companion system input; do
    local json_value="${!value}"
    jq -e . >/dev/null 2>&1 <<<"$json_value" || printf -v "$value" '{}'
  done
  jq -n \
    --arg version "$(manifest_value version)" \
    --argjson hardware "$hardware" \
    --argjson effects "$effects" \
    --argjson sensors "$sensors" \
    --argjson companion "$companion" \
    --argjson system "$system" \
    --argjson input "$input" \
    --argjson safeMode "$(if [[ -f "$omanome_config_dir/safe-mode" ]]; then printf true; else printf false; fi)" \
    '{schemaVersion:1,version:$version,safeMode:$safeMode,hardware:$hardware,input:$input,effects:$effects,sensors:$sensors,companion:$companion,system:$system,policy:{optionalBackendsFailClosed:true,realHardwareOnly:true,privateTextExcluded:true}}'
}

hardware_test_cmd() {
  python3 "$repo_dir/scripts/hardware_test.py" "$@"
}

support_bundle_cmd() {
  ensure_dirs
  local output="" private=0 argument
  for argument in "$@"; do
    case "$argument" in
      --private) private=1 ;;
      --*) die "unsupported support bundle option: $argument" ;;
      *) [[ -z "$output" ]] || die "support bundle accepts one output path"; output="$argument" ;;
    esac
  done
  [[ -n "$output" ]] || output="$omanome_state_dir/support-bundles/$(date -u +%Y%m%d-%H%M%S).tar.gz"
  local private_args=()
  [[ "$private" -eq 1 ]] && private_args+=(--private)
  python3 "$repo_dir/scripts/support_bundle.py" "${private_args[@]}" --output "$output" --config "$(config_file)" --state "$omanome_state_dir"
}

diagnostics_cmd() {
  local operation="${1:-capabilities}"
  shift || true
  case "$operation" in
    capabilities) capabilities_cmd "$@" ;;
    hardware|hardware-test) hardware_test_cmd "$@" ;;
    bundle|support-bundle|export)
      # --private selects the stricter local redaction policy; it never
      # disables redaction and never uploads data.
      support_bundle_cmd "$@" ;;
    doctor) doctor_cmd --json "$@" ;;
    mode-info) mode_info_cmd "$@" ;;
    feature-list|features) feature_list_cmd "$@" ;;
    *) usage >&2; die "unknown diagnostics operation: $operation" ;;
  esac
}

benchmark_cmd() {
  local watch=0 json=0
  for argument in "$@"; do
    [[ "$argument" == "--watch" ]] && watch=1
    [[ "$argument" == "--json" ]] && json=1
  done
  if [[ "$watch" -eq 1 ]]; then
    local watch_args=("--watch" "--interval" "1" "--sample-ms" "100")
    [[ "$json" -eq 1 ]] && watch_args+=("--json")
    exec python3 "$process_snapshot" "${watch_args[@]}"
  fi
  local layers="unavailable"
  local clients="unavailable"
  if has hyprctl; then
    layers="$(hyprctl layers 2>/dev/null | awk '/namespace:/ { count++ } END { print count + 0 }')"
    clients="$(hyprctl clients -j 2>/dev/null | jq 'length' 2>/dev/null || printf 'unavailable')"
  fi
  local ownership='{}'
  ownership="$(python3 "$process_snapshot" --json --sample-ms 100 2>/dev/null || printf '{}')"
  jq -e . >/dev/null 2>&1 <<<"$ownership" || ownership='{}'
  jq -n \
    --arg version "$(manifest_value version)" \
    --arg quickshell "$(quickshell --version 2>/dev/null | head -n 1 || printf 'unavailable')" \
    --arg hyprland "$(hyprctl version 2>/dev/null | head -n 1 || printf 'unavailable')" \
    --arg layers "$layers" \
    --arg clients "$clients" \
    --argjson ownership "$ownership" \
    '{schemaVersion:2,version:$version,quickshell:$quickshell,hyprland:$hyprland,layerCount:($layers|tonumber? // null),clientCount:($clients|tonumber? // null),ownerOnly:$ownership,metrics:{systemCpuPercent:($ownership.systemCpuPercent // null),omanomeCpuPercent:($ownership.ownerCpuPercent // $ownership.totalCpuPercent // null),helperCpuPercent:($ownership.helperCpuPercent // null),quickshellCpuPercent:($ownership.quickshellCpuPercent // null),companionCpuPercent:($ownership.companionCpuPercent // null),omanomeProcessCount:($ownership.processCount // 0),helperProcessCount:($ownership.helperProcessCount // 0),memoryBytes:($ownership.totalMemoryBytes // 0),subprocessRatePerMinute:($ownership.subprocessRatePerMinute // null),activeTimers:($ownership.activeTimers // null),previewStreams:($ownership.previewStreams // 0),activeExpensiveComponents:($ownership.activeExpensiveComponents // [])},measurement:{foreignProcessesExcluded:true,quickshellCpu:"not measured unless the host exposes an explicit Omanome-owned identity",companionCpu:"not measured unless the companion exposes an explicit Omanome-owned identity"},method:"owner-only snapshot; no per-frame polling; no process termination"}'
}

processes_cmd() {
  local json=0
  for argument in "$@"; do [[ "$argument" == "--json" ]] && json=1; done
  if [[ "$json" -eq 1 ]]; then
    python3 "$process_snapshot" --json --sample-ms 100
  else
    python3 "$process_snapshot" --sample-ms 100
  fi
}

profiler_cmd() {
  python3 "$process_snapshot" --watch --interval 1 --sample-ms 100 "$@"
}

watchdog_cmd() {
  python3 "$process_watchdog" "$@"
}

performance_cmd() {
  local operation="${1:-snapshot}"
  shift || true
  case "$operation" in
    reset) python3 "$process_snapshot" --reset --json "$@" ;;
    check) python3 "$performance_check" --json "$@" ;;
    snapshot|benchmark) benchmark_cmd "$@" ;;
    watchdog) watchdog_cmd "$@" ;;
    *) usage >&2; die "unknown performance operation: $operation" ;;
  esac
}

version_cmd() { manifest_value version; }

command_name="${1:-}"
shift || true
case "$command_name" in
  status) status_cmd "$@" ;;
  doctor) doctor_cmd "$@" ;;
  logs) logs_cmd "$@" ;;
  reload) reload_cmd "$@" ;;
  enable) enable_cmd "$@" ;;
  disable) disable_cmd "$@" ;;
  safe-mode) safe_mode_cmd "$@" ;;
  setup) setup_cmd "$@" ;;
  install) install_cmd "$@" ;;
  export-config) export_cmd "$@" ;;
  import-config) import_cmd "$@" ;;
  config) config_cmd "$@" ;;
  reset) reset_cmd "$@" ;;
  update) update_cmd "$@" ;;
  rollback) rollback_cmd "$@" ;;
  recover) recover_cmd "$@" ;;
  uninstall) uninstall_cmd "$@" ;;
  devices) devices_cmd "$@" ;;
  device)
    device_command="${1:-info}"
    shift || true
    case "$device_command" in
      info) device_info_cmd "$@" ;;
      test) device_test_cmd "$@" ;;
      reset|rollback) device_mutation_cmd "$device_command" "$@" ;;
      *) usage >&2; die "unknown device command: $device_command" ;;
    esac
    ;;
  hardware-setup) hardware_setup_cmd "$@" ;;
  hardware)
    hardware_command="${1:-graph}"
    shift || true
    case "$hardware_command" in
      graph) hardware_graph_cmd "$@" ;;
      *) usage >&2; die "unknown hardware command: $hardware_command" ;;
    esac
    ;;
  mode-info) mode_info_cmd "$@" ;;
  master) master_cmd "$@" ;;
  suspend) suspend_cmd "$@" ;;
  resume) resume_cmd "$@" ;;
  feature-list) feature_list_cmd "$@" ;;
  feature)
    feature_cmd "$@"
    ;;
  input-info) input_info_cmd "$@" ;;
  stylus-info) stylus_info_cmd "$@" ;;
  touch-info) touch_info_cmd "$@" ;;
  sensor-info) sensor_info_cmd "$@" ;;
  effects) effects_cmd "$@" ;;
  capabilities) capabilities_cmd "$@" ;;
  hardware-test) hardware_test_cmd "$@" ;;
  diagnostics) diagnostics_cmd "$@" ;;
  processes) processes_cmd "$@" ;;
  benchmark) benchmark_cmd "$@" ;;
  profiler) profiler_cmd "$@" ;;
  watchdog) watchdog_cmd "$@" ;;
  performance) performance_cmd "$@" ;;
  companion)
    companion_command="${1:-status}"
    shift || true
    case "$companion_command" in
      status) companion_info_cmd "$@" ;;
      doctor) companion_doctor_cmd "$@" ;;
      build) companion_build_cmd "$@" ;;
      install) companion_install_cmd "$@" ;;
      rebuild) companion_rebuild_cmd "$@" ;;
      enable) companion_enable_cmd "$@" ;;
      disable) companion_disable_cmd "$@" ;;
      recover) companion_recover_cmd "$@" ;;
      *) usage >&2; die "unknown companion command: $companion_command" ;;
    esac
    ;;
  version) version_cmd "$@" ;;
  help|-h|--help|"") usage ;;
  *) usage >&2; die "unknown command: $command_name" ;;
esac
