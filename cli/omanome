feature_list_cmd() {
  local json=0
  for argument in "$@"; do [[ "$argument" == "--json" ]] && json=1; done
  local service='{}' source="service" config='{}' definitions='[]' service_result=""
  if service_result="$(service_status_json 2>/dev/null)"; then service="$service_result"; else source="fallback"; service='{}'; fi
  if [[ -f "$(config_file)" ]]; then config="$(jq -c . "$(config_file)" 2>/dev/null || printf '{}')"; else config="$(jq -c . "$repo_dir/config/defaults.json" 2>/dev/null || printf '{}')"; fi
  definitions="$(feature_fallback_definitions)"
  local payload
  payload="$(jq -n --arg source "$source" --arg profile "$(jq -r '.profile // .adaptive.profile // "auto"' <<<"$service" 2>/dev/null || printf 'auto')" --argjson service "$service" --argjson config "$config" --argjson definitions "$definitions" '
    def safe_rows($value): if (($value.features.states | type) == "array") then $value.features.states else [] end;
    def configured($path; $fallback):
      (reduce (($path | split("."))[]) as $part ($config;
        if (type == "object" and has($part)) then .[$part] else null end)) as $value
      | if $value == null then $fallback else ($value != false) end;
    if $source == "service" then
      (safe_rows($service)) as $rows
      | {schemaVersion:1,source:$source,profile:$profile,
         summary:{total:($rows|length),available:([ $rows[] | select(.available == true) ]|length),active:([ $rows[] | select(.effectiveEnabled == true) ]|length),partial:(([ $rows[] | select(.effectiveEnabled == true) ]|length) > 0 and ([ $rows[] | select(.available == true) ]|length) > ([ $rows[] | select(.effectiveEnabled == true) ]|length))},
         features:($rows | map({id,label,configPath,available:(.available == true),enabled:(.effectiveEnabled == true),effectiveEnabled:(.effectiveEnabled == true),userEnabled:(.userEnabled == true),disabledReason:(.disabledReason // ""),temporarilySuppressed:(.temporarilySuppressed == true),overrideSource:(.overrideSource // "unknown"),profile:(.profile // $profile)})),
         privacy:{bluetoothMacEmitted:false,serialsEmitted:false,typedTextLogged:false}}
    else
      ($definitions | map({id,label,configPath,available:null,enabled:null,effectiveEnabled:null,userEnabled:configured(.configPath;.defaultEnabled),disabledReason:"Omanome service is not running",temporarilySuppressed:false,overrideSource:"service-unavailable",profile:$profile})) as $rows
      | {schemaVersion:1,source:$source,profile:$profile,summary:{total:($rows|length),available:0,active:0,partial:false},features:$rows,privacy:{bluetoothMacEmitted:false,serialsEmitted:false,typedTextLogged:false}}
    end' )"
  if [[ "$json" -eq 1 ]]; then
    printf '%s\n' "$payload"
  else
    printf '%s\n' "$payload" | jq -r 'if (.features | length) == 0 then "No feature state is available." else (.features[] | "\(.id): " + (if .effectiveEnabled == true then "enabled" elif .effectiveEnabled == false then "disabled" else "unknown" end) + (if .disabledReason != "" then " — " + .disabledReason else "" end)) end'
  fi
}

feature_control_cmd() {
  local operation="$1" id="${2:-}" json=0 value=""
  shift 2 || true
  for argument in "$@"; do [[ "$argument" == "--json" ]] && json=1; done
  [[ -n "$id" ]] || die "feature $operation requires a feature id"
  case "$operation" in
    enable) value="true" ;;
    disable) value="false" ;;
    toggle) value="toggle" ;;
    *) die "unknown feature operation: $operation" ;;
  esac
  local result="" call_ok=0
  if has omarchy-shell && result="$(omarchy-shell "$plugin_id" feature "$id" "$value" 2>/dev/null)"; then
    local last_line="${result##*$'\n'}"
    last_line="${last_line%$'\r'}"
    [[ "$last_line" == "ok" ]] && call_ok=1
  else
    result="omarchy-shell is unavailable"
  fi
  if [[ "$json" -eq 1 ]]; then
    jq -n --arg operation "$operation" --arg id "$id" --arg result "$result" --argjson ok "$(if [[ "$call_ok" -eq 1 ]]; then printf true; else printf false; fi)" '{schemaVersion:1,operation:$operation,feature:$id,ok:$ok,result:$result,privacy:{typedTextLogged:false}}'
  elif [[ "$call_ok" -eq 1 ]]; then
    say "Feature $id: $operation requested."
  else
    say "omanome: failed to $operation feature $id: $result" >&2
  fi
  [[ "$call_ok" -eq 1 ]] || return "$EX_NETWORK"
}

feature_cmd() {
  local operation="${1:-list}"
  shift || true
  case "$operation" in
    list) feature_list_cmd "$@" ;;
    enable|disable|toggle) feature_control_cmd "$operation" "$@" ;;
    *) usage >&2; die "unknown feature operation: $operation" ;;
  esac
}

master_cmd() {
  local operation="${1:-status}"
  shift || true
  case "$operation" in
    on|enable) service_control_cmd enable "$@" ;;
    off|disable) service_control_cmd disable "$@" ;;
    status) status_cmd "$@" ;;
    *) die "master expects on, off, or status" ;;
  esac
}

suspend_cmd() { service_control_cmd suspend "$@"; }
resume_cmd() { service_control_cmd resume "$@"; }

doctor_cmd() {
  local json=0
  for argument in "$@"; do [[ "$argument" == "--json" ]] && json=1; done
  if [[ "$json" -eq 1 ]]; then doctor_json_cmd; return; fi
  local failed=0
  say "Omanome $(manifest_value version)"
  say "Repository: $repo_dir"
  if jq -e '(.kinds // []) | index("bar") != null' "$manifest_path" >/dev/null; then
    say "FAIL: manifest declares replacement bar"
    failed=1
  else
    say "OK: manifest does not declare replacement bar"
  fi

  for command_name in omarchy quickshell hyprctl wl-paste wl-copy wtype; do
    if has "$command_name"; then say "OK: $command_name -> $(command -v "$command_name")"; else say "WARN: optional/missing $command_name"; fi
  done

  if [[ -n "${OMARCHY_PATH:-}" && -f "${OMARCHY_PATH}/shell/services/PluginRegistry.qml" ]]; then
    say "OK: OMARCHY_PATH points to a Quattro shell"
  else
    say "WARN: OMARCHY_PATH is not set to an Omarchy shell in this process"
  fi

  if [[ -x /usr/lib/qt6/bin/qmllint ]]; then
    if make -C "$repo_dir" qmllint >/dev/null 2>&1; then say "OK: QML lint"; else say "WARN: QML lint reported errors; run make qmllint"; failed=1; fi
  else
    say "WARN: qmllint is not installed"
  fi

  if has omarchy && omarchy plugin validate "$repo_dir" >/dev/null 2>&1; then say "OK: Omarchy manifest validation"; else say "WARN: Omarchy plugin validation unavailable or failed"; failed=1; fi
  say "Safety: no sudo, no X11 backend, no second Quickshell, no bar replacement"
  return "$failed"
}

doctor_json_cmd() {
  local failed=0 manifest_ok=0 qmllint_ok=0 omarchy_ok=0 config_ok=0
  if jq -e '.id == "io.omanome.shell" and ((.kinds // []) | index("bar") == null)' "$manifest_path" >/dev/null 2>&1; then manifest_ok=1; else failed=1; fi
  if [[ -x /usr/lib/qt6/bin/qmllint ]] && make -C "$repo_dir" qmllint >/dev/null 2>&1; then qmllint_ok=1; elif ! [[ -x /usr/lib/qt6/bin/qmllint ]]; then qmllint_ok=1; else failed=1; fi
  if has omarchy && omarchy plugin validate "$repo_dir" >/dev/null 2>&1; then omarchy_ok=1; else failed=1; fi
  local config_target="$(config_file)"
  [[ -f "$config_target" ]] || config_target="$repo_dir/config/defaults.json"
  if python3 "$config_tool" validate "$config_target" >/dev/null 2>&1; then config_ok=1; else failed=1; fi
  local companion='{}'
  if [[ -x "$repo_dir/input/companion-info.sh" ]]; then companion="$("$repo_dir/input/companion-info.sh" 2>/dev/null || printf '{}')"; fi
  jq -e . >/dev/null 2>&1 <<<"$companion" || companion='{}'
  jq -n \
    --arg version "$(manifest_value version)" \
    --arg repository "$repo_dir" \
    --arg transaction "$(if [[ -f "$transaction_file" ]]; then jq -r '.phase // "unknown"' "$transaction_file" 2>/dev/null || printf 'unknown'; else printf 'none'; fi)" \
    --argjson manifest "$(if [[ "$manifest_ok" -eq 1 ]]; then printf true; else printf false; fi)" \
    --argjson qmllint "$(if [[ "$qmllint_ok" -eq 1 ]]; then printf true; else printf false; fi)" \
    --argjson omarchy "$(if [[ "$omarchy_ok" -eq 1 ]]; then printf true; else printf false; fi)" \
    --argjson config "$(if [[ "$config_ok" -eq 1 ]]; then printf true; else printf false; fi)" \
    --argjson safeMode "$(if [[ -f "$omanome_config_dir/safe-mode" ]]; then printf true; else printf false; fi)" \
    --argjson companion "$companion" \
    --argjson failed "$failed" \
    '{schemaVersion:1,version:$version,repository:$repository,ok:($failed == 0),checks:{manifest:$manifest,qmllint:$qmllint,omarchy:$omarchy,config:$config},safeMode:$safeMode,transaction:$transaction,companion:$companion,safety:{noSudo:true,noX11:true,noSecondShell:true,noReplacementBar:true}}'
  return "$failed"
}

logs_cmd() {
  if has journalctl; then
    journalctl --user -n 120 --no-pager 2>/dev/null | rg -i 'omanome|quickshell|omarchy-shell' || true
  else
    say "journalctl is unavailable; use quickshell log from the graphical session"
  fi
}

reload_cmd() {
  if ! has omarchy-shell; then
    say "omarchy-shell is unavailable; plugin reload was skipped" >&2
    return "$EX_NETWORK"
  fi
  omarchy-shell shell rescanPlugins
}

enable_cmd() {
  if service_status_json >/dev/null 2>&1; then
    service_control_cmd enable "$@"
    return
  fi
  has omarchy || die "omarchy is not installed"
  omarchy plugin enable "$plugin_id"
  reload_cmd || true
}

disable_cmd() {
  if service_status_json >/dev/null 2>&1; then
    service_control_cmd disable "$@"
    return
  fi
  has omarchy || die "omarchy is not installed"
  omarchy plugin disable "$plugin_id"
  reload_cmd || true
}

safe_mode_cmd() {
  local action="on" json=0
  for argument in "$@"; do
    [[ "$argument" == "--json" ]] && json=1
    [[ "$argument" != --* ]] && action="$argument"
  done
  ensure_dirs
  case "$action" in
    status)
      if [[ "$json" -eq 1 ]]; then
        jq -n --arg marker "$omanome_config_dir/safe-mode" --argjson active "$(if [[ -f "$omanome_config_dir/safe-mode" ]]; then printf true; else printf false; fi)" '{active:$active,marker:$marker,reason:(if $active then "advanced Omanome effects are disabled" else "safe mode is inactive" end)}'
      elif [[ -f "$omanome_config_dir/safe-mode" ]]; then say "Omanome safe mode is active."; else say "Omanome safe mode is inactive."; fi
      ;;
    on|enable)
      json_atomic_write "$omanome_config_dir/safe-mode" "$(jq -n --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '{schemaVersion:1,enabled:true,reason:"explicit safe-mode request",at:$at}')"
      if has omarchy; then omarchy plugin disable "$plugin_id" || true; else say "omarchy is unavailable; plugin disable will apply on the next shell operation." >&2; fi
      if [[ "$json" -eq 1 ]]; then companion_disable_cmd >/dev/null 2>&1 || true; else companion_disable_cmd || true; fi
      if [[ "$json" -eq 1 ]]; then jq -n '{active:true,changed:true}'; else say "Omanome safe mode enabled; the standard Omarchy shell remains available."; fi
      ;;
    off|disable)
      safe_remove_file "$omanome_config_dir/safe-mode" "$omanome_config_dir"
      if has omarchy; then omarchy plugin enable "$plugin_id" || true; fi
      reload_cmd || true
      if [[ "$json" -eq 1 ]]; then jq -n '{active:false,changed:true}'; else say "Omanome safe mode disabled; review optional companion effects before enabling them."; fi
      ;;
    *) die "safe-mode expects on, off, or status" ;;
  esac
}

companion_info_cmd() {
  [[ -x "$repo_dir/input/companion-info.sh" ]] || die "companion diagnostics are unavailable"
  "$repo_dir/input/companion-info.sh" | jq .
}

companion_runtime_abi() {
  if has hyprctl; then
    hyprctl version 2>/dev/null | sed -n 's/^Version ABI string:[[:space:]]*//p' | head -n 1
  fi
}

companion_runtime_version() {
  if has hyprctl; then
    hyprctl version 2>/dev/null | sed -n '1s/^Hyprland[[:space:]]\+//p' | awk '{print $1}'
  fi
}

companion_runtime_commit() {
  if has hyprctl; then
    hyprctl version 2>/dev/null | sed -n '1s/.*commit[[:space:]]\+\([[:alnum:]_:-]\+\).*/\1/p' | head -n 1
  fi
