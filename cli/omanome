devices_cmd() {
  local json=0
  for argument in "$@"; do [[ "$argument" == "--json" ]] && json=1; done

  local service='{}'
  if service="$(service_status_json 2>/dev/null)"; then
    local payload
    payload="$(jq -n --argjson service "$service" '
      def keyboard($item): {
        category: ($item.category // "external"),
        classification: ($item.classification // $item.formFactorRelation // "unknown"),
        transport: ($item.transport // "unknown"),
        connected: ($item.connected == true),
        behavior: ($item.behavior // "generic"),
        ignored: ($item.ignored == true),
        capabilityEvidence: ($item.capabilityEvidence // "service"),
        capabilities: {
          normalKeyboard: ($item.capabilities.normalKeyboard == true),
          functionRow: ($item.capabilities.functionRow == true),
          numberRow: ($item.capabilities.numberRow == true),
          modifiers: ($item.capabilities.modifiers == true),
          navigation: ($item.capabilities.navigation == true)
        }
      };
      ($service | if type == "object" then . else {} end) as $s
      | {schemaVersion:1,source:"service",physicalKeyboards:(($s.keyboards // []) | map(keyboard(.))),
         touchscreen:{present:($s.hasTouchscreen == true),count:(if $s.hasTouchscreen == true then 1 else 0 end)},
         stylus:{present:($s.hasStylus == true),count:($s.stylusCount // (if $s.hasStylus == true then 1 else 0 end))},
         dockedMode:{active:($s.dockedMode.active == true),externalMonitor:($s.dockedMode.externalMonitor == true),externalMonitorCount:($s.dockedMode.externalMonitorCount // 0)},
         privacy:{bluetoothMacEmitted:false,serialsEmitted:false,ephemeralPathsEmitted:false,typedTextLogged:false}}')"
    if [[ "$json" -eq 1 ]]; then printf '%s\n' "$payload"; else jq -r '"Physical keyboards: \(.physicalKeyboards | length)\n" + (.physicalKeyboards[]? | "- \(.classification), \(.transport), " + (if .connected then "connected" else "disconnected" end) + ", behavior=\(.behavior)") + "\nTouchscreen: " + (if .touchscreen.present then "present" else "absent" end) + "\nStylus: " + (if .stylus.present then "present" else "absent" end)' <<<"$payload"; fi
    return 0
  fi

  local devices='{}' safe='{}' source="hyprland"
  if has hyprctl; then devices="$(hyprctl devices -j 2>/dev/null || printf '{}')"; else source="unavailable"; fi
  jq -e . >/dev/null 2>&1 <<<"$devices" || devices='{}'
  safe="$(printf '%s\n' "$devices" | sanitize_hypr_devices)"
  local payload
  payload="$(jq -n --arg source "$source" --argjson devices "$safe" '
    {schemaVersion:1,source:$source,physicalKeyboards:$devices.keyboards,
     touchscreen:{present:(($devices.touchDevices | length) > 0),count:($devices.touchDevices | length)},
     stylus:{present:(($devices.tablets | length) > 0),count:($devices.tablets | length)},
     dockedMode:{active:false,externalMonitor:null,externalMonitorCount:null},
     privacy:{bluetoothMacEmitted:false,serialsEmitted:false,ephemeralPathsEmitted:false,typedTextLogged:false}}')"
  if [[ "$json" -eq 1 ]]; then printf '%s\n' "$payload"; else jq -r '"Physical keyboards: \(.physicalKeyboards | length)\n" + (.physicalKeyboards[]? | "- \(.classification), \(.transport), " + (if .connected then "connected" else "disconnected" end)) + "\nTouchscreen: " + (if .touchscreen.present then "present" else "absent" end) + "\nStylus: " + (if .stylus.present then "present" else "absent" end)' <<<"$payload"; fi
}

