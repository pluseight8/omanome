#!/usr/bin/env bash
set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_dir="$(cd -- "$script_dir/.." && pwd -P)"
user_home="${HOME:-}"
config_home="${XDG_CONFIG_HOME:-$user_home/.config}"
state_home="${XDG_STATE_HOME:-$user_home/.local/state}"
data_home="${XDG_DATA_HOME:-$user_home/.local/share}"
cache_home="${XDG_CACHE_HOME:-$user_home/.cache}"
omanome_config_dir="$config_home/omanome"
omanome_state_dir="$state_home/omanome"
omanome_cache_dir="$cache_home/omanome"
plugin_id="io.omanome.shell"
repository_url="https://github.com/pluseight8/omanome.git"
repository_manifest_url="https://raw.githubusercontent.com/pluseight8/omanome/main/manifest.json"
installed_plugin_dir="$config_home/omarchy/plugins/$plugin_id"
rollback_dir="$omanome_state_dir/rollback"
manifest_path="$repo_dir/manifest.json"
companion_root="$repo_dir/hypr/omanome-hypr"
companion_manifest="$companion_root/compatibility.json"
companion_data_dir="$data_home/omanome/companion"
companion_artifact="$companion_data_dir/omanome-hypr.so"
companion_state_dir="$omanome_state_dir/companion"
companion_pending_marker="$companion_state_dir/load.pending"
companion_disabled_marker="$companion_state_dir/disabled"
companion_lifecycle_file="$companion_state_dir/lifecycle.json"
companion_lifecycle_log="$companion_state_dir/lifecycle.log"
companion_backup_dir="$companion_state_dir/artifacts"
config_tool="$repo_dir/scripts/config_tool.py"
process_snapshot="$repo_dir/scripts/process_snapshot.py"
performance_check="$repo_dir/scripts/performance_check.py"
process_watchdog="$repo_dir/scripts/process_watchdog.py"
transaction_dir="$omanome_state_dir/transactions"
transaction_file="$transaction_dir/current.json"
transaction_history_dir="$transaction_dir/history"
failed_update_dir="$omanome_state_dir/failed-updates"
update_lock_file="$omanome_state_dir/update.lock"
ownership_manifest="$omanome_state_dir/ownership.json"

EX_USAGE=2
EX_CONFIG=78
EX_NETWORK=69
EX_UPDATE=70
EX_RECOVERY=71

say() { printf '%s\n' "$*"; }
die() { printf 'omanome: %s\n' "$*" >&2; exit "$EX_USAGE"; }
has() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'EOF'
Usage: omanome <command> [options]

Commands:
  status                 Show shell/service status without clipboard contents
  doctor                 Check Omarchy, Hyprland, Wayland and plugin safety
  logs                  Show recent user-session logs (payloads are not added)
  reload                Ask the existing Omarchy shell to rescan plugins
  enable | disable       Temporarily enable or disable Omanome (master toggle)
  master on | off        Set the Omanome master toggle explicitly
  suspend | resume       Pause or resume runtime enhancements
  safe-mode              Disable Omanome and create a safe-mode marker
  setup                  Print optional dependencies and prepare user dirs
  install                Install this plugin from the official GitHub repo
  export-config [file]   Print or export the versioned config
  import-config <file>   Validate and import a config, keeping a backup
  config <operation>      Validate, migrate, recover, diff, export, or import config
  reset [--yes]          Reset Omanome's config only
  update --check         Check the installed checkout and compatibility
  update                 Create rollback point, then use Omarchy plugin update
  rollback               Restore the newest Omanome rollback point
  recover                Recover an interrupted update transaction
  uninstall [--purge-settings] [--yes]
  version                Print Omanome version
  mode-info [--json]     Explain policy, effective mode, input and dock state
  feature list [--json]  List feature availability and effective state
  feature enable|disable <id>
                         Change one feature without changing other preferences
  input-info             Print native input protocol and fallback diagnostics
  stylus-info            Print capability inventory without changing input
  touch-info             Print touchscreen inventory without changing input
  sensor-info            Print rotation sensor backend diagnostics
  companion status       Print optional Hyprland companion state
  companion doctor       Check companion headers, ABI and safe loading
  companion build        Build the companion in the user checkout
  companion install      Build and copy the companion to user data
  companion rebuild      Rebuild and reinstall the companion
  companion enable       Load a compatible user-owned companion
  companion disable      Unload the optional companion
  companion recover      Disable, restore the newest companion backup, and clear pending state
  effects                Print effect and preview backend capabilities
  capabilities           Print merged capability probes as stable JSON
  hardware-test          Run non-destructive hardware probes (fixture or --guided checklist)
  diagnostics bundle     Create a redacted support bundle
  diagnostics export     Create the same redacted bundle (explicit --private accepted)
  processes [--json]     Print only explicitly Omanome-owned processes
  benchmark [--watch]    Print runtime CPU/RAM/process diagnostics
  profiler               Watch the same owner-only performance snapshot
  watchdog [--watch]     Notify about sustained owner-only resource pressure
  performance reset      Reset local performance counters/state
  devices [--json]       Print classified, privacy-safe device inventory
  device info <id>       Show one sanitized device profile and health
  device test <id>       Run a non-destructive inventory health check
  device reset <id>      Remove Omanome profile and calibration metadata
  device rollback <id>   Restore the device last-known-good calibration
  hardware-setup list    List generic hardware setup presets
  hardware-setup status  Show selected setup and runtime topology match
  hardware-setup apply <name>
                         Select a hardware setup without changing window layout
  hardware graph [--json]
                         Print the sanitized universal device graph
EOF
}

manifest_value() {
  jq -r --arg key "$1" '.[$key] // empty' "$manifest_path"
}

config_file() { printf '%s/config.json\n' "$omanome_config_dir"; }

ensure_dirs() {
  path_is_safe_directory "$omanome_config_dir" "$config_home" || die "refusing unsafe Omanome config directory: $omanome_config_dir"
  path_is_safe_directory "$omanome_state_dir" "$state_home" || die "refusing unsafe Omanome state directory: $omanome_state_dir"
  path_is_safe_directory "$omanome_cache_dir" "$cache_home" || die "refusing unsafe Omanome cache directory: $omanome_cache_dir"
  path_is_safe_directory "$rollback_dir" "$omanome_state_dir" || die "refusing unsafe rollback directory: $rollback_dir"
  path_is_safe_directory "$transaction_dir" "$omanome_state_dir" || die "refusing unsafe transaction directory: $transaction_dir"
  path_is_safe_directory "$transaction_history_dir" "$transaction_dir" || die "refusing unsafe transaction history directory: $transaction_history_dir"
  path_is_safe_directory "$failed_update_dir" "$omanome_state_dir" || die "refusing unsafe failed-update directory: $failed_update_dir"
  path_is_safe_directory "$companion_state_dir" "$omanome_state_dir" || die "refusing unsafe companion state directory: $companion_state_dir"
  path_is_safe_directory "$companion_backup_dir" "$companion_state_dir" || die "refusing unsafe companion backup directory: $companion_backup_dir"
  mkdir -p -- "$omanome_config_dir" "$omanome_state_dir" "$omanome_cache_dir" "$rollback_dir" "$transaction_dir" "$transaction_history_dir" "$failed_update_dir" "$companion_state_dir" "$companion_backup_dir"
}

path_has_symlink_component() {
  local path="$1" component cursor="/"
  [[ "$path" = /* ]] || return 0
  local -a components=()
  IFS=/ read -r -a components <<< "${path#/}"
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    cursor="${cursor%/}/$component"
    [[ ! -L "$cursor" ]] || return 0
  done
  return 1
}

path_is_safe_directory() {
  local path="$1" expected_parent="${2:-}"
  [[ -n "$path" && "$path" = /* && "$path" != "/" && ! -L "$path" ]] || return 1
  ! path_has_symlink_component "$path" || return 1
  [[ -z "$expected_parent" || "$path" == "$expected_parent" || "$path" == "$expected_parent"/* ]] || return 1
  return 0
}

path_is_safe_file() {
  local path="$1" expected_parent="${2:-}"
  [[ -n "$path" && "$path" = /* && "$path" != "/" && ! -L "$path" ]] || return 1
  ! path_has_symlink_component "$path" || return 1
  [[ -z "$expected_parent" || "$path" == "$expected_parent"/* ]] || return 1
  return 0
}

write_ownership_manifest() {
  ensure_dirs
  local content
  content="$(jq -n \
    --arg generatedAt "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    --arg pluginId "$plugin_id" \
    --arg plugin "$installed_plugin_dir" \
    --arg config "$omanome_config_dir" \
    --arg state "$omanome_state_dir" \
    --arg cache "$omanome_cache_dir" \
    --arg companion "$companion_data_dir" \
    '{schemaVersion:1,pluginId:$pluginId,generatedAt:$generatedAt,managedPaths:{plugin:$plugin,config:$config,state:$state,cache:$cache,companion:$companion}}')"
  json_atomic_write "$ownership_manifest" "$content"
}

safe_remove_directory() {
  local path="$1" parent="$2"
  path_is_safe_directory "$path" "$parent" || die "refusing unsafe directory removal: $path"
  [[ -d "$path" ]] || return 0
  rm -rf -- "$path"
}

safe_remove_file() {
  local path="$1" parent="$2"
  path_is_safe_file "$path" "$parent" || die "refusing unsafe file removal: $path"
  [[ -e "$path" ]] || return 0
  rm -f -- "$path"
}

process_is_omanome_owned() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ && "$pid" != "$$" && "$pid" != "${BASHPID:-}" ]] || return 1
  [[ -r "/proc/$pid/environ" ]] || return 1
  tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -Fqx 'OMANOME_OWNER=io.omanome.shell'
}

omanome_owned_pids() {
  local proc pid
  for proc in /proc/[0-9]*; do
    pid="${proc##*/}"
    process_is_omanome_owned "$pid" && printf '%s\n' "$pid"
  done
}

stop_owned_processes() {
  local -a pids=()
  local pid attempt remaining=0 total=0
  # A just-spawned helper can briefly be between fork/exec while its proc
  # environment is being published. Retry only the empty result so uninstall
  # remains bounded without widening the ownership rule.
  for attempt in 1 2 3 4 5; do
    mapfile -t pids < <(omanome_owned_pids)
    total="${#pids[@]}"
    (( total > 0 )) && break
    sleep 0.05
  done
  for pid in "${pids[@]}"; do
    process_is_omanome_owned "$pid" || continue
    kill -TERM -- "$pid" 2>/dev/null || true
  done
  if (( total > 0 )); then sleep 0.1; fi
  for pid in "${pids[@]}"; do
    if process_is_omanome_owned "$pid" && kill -0 -- "$pid" 2>/dev/null; then
      kill -KILL -- "$pid" 2>/dev/null || true
    fi
  done
  if (( total > 0 )); then sleep 0.05; fi
  for pid in "${pids[@]}"; do
    if process_is_omanome_owned "$pid" && kill -0 -- "$pid" 2>/dev/null; then
      remaining=$((remaining + 1))
    fi
  done
  uninstall_owned_processes_stopped=$((total - remaining))
  uninstall_owned_processes_failed=$remaining
  (( remaining == 0 ))
}

ownership_manifest_matches() {
  [[ -f "$ownership_manifest" && ! -L "$ownership_manifest" ]] || return 1
  jq -e \
    --arg pluginId "$plugin_id" \
    --arg plugin "$installed_plugin_dir" \
    --arg config "$omanome_config_dir" \
    --arg state "$omanome_state_dir" \
    --arg cache "$omanome_cache_dir" \
    --arg companion "$companion_data_dir" \
    '.schemaVersion == 1 and .pluginId == $pluginId and
     (.managedPaths | type == "object" and
      .plugin == $plugin and .config == $config and .state == $state and
      .cache == $cache and .companion == $companion)' \
    "$ownership_manifest" >/dev/null 2>&1
}

uninstall_target_is_safe() {
  local path="$1" parent="$2"
  case "$path" in
    /|"$user_home"|"$config_home"|"$state_home"|"$data_home"|"$cache_home"|\
      "$config_home/omarchy"|"$config_home/omarchy/plugins"|"$data_home/omanome")
      return 1
      ;;
  esac
  path_is_safe_directory "$path" "$parent"
}

uninstall_preflight() {
  uninstall_ownership_status="legacy"
  uninstall_transaction_pending=0

  if [[ -L "$omanome_state_dir" ]]; then
    die "refusing uninstall: Omanome state directory is a symlink"
  fi
  if [[ -L "$ownership_manifest" ]]; then
    die "refusing uninstall: ownership manifest is a symlink"
  fi
  if [[ -e "$ownership_manifest" ]]; then
    ownership_manifest_matches || die "refusing uninstall: ownership manifest does not match this Omanome installation"
    uninstall_ownership_status="verified"
  fi

  uninstall_target_is_safe "$installed_plugin_dir" "$config_home/omarchy/plugins" || die "refusing uninstall: unsafe plugin path"
  uninstall_target_is_safe "$omanome_state_dir" "$state_home" || die "refusing uninstall: unsafe state path"
  uninstall_target_is_safe "$omanome_cache_dir" "$cache_home" || die "refusing uninstall: unsafe cache path"
  uninstall_target_is_safe "$companion_data_dir" "$data_home/omanome" || die "refusing uninstall: unsafe companion path"

  if [[ "$uninstall_purge_settings" -eq 1 ]]; then
    uninstall_target_is_safe "$omanome_config_dir" "$config_home" || die "refusing uninstall: unsafe config path"
  elif [[ -e "$omanome_config_dir/safe-mode" || -L "$omanome_config_dir/safe-mode" ]]; then
    path_is_safe_file "$omanome_config_dir/safe-mode" "$omanome_config_dir" || die "refusing uninstall: safe-mode marker is unsafe"
  fi

  if [[ -e "$update_lock_file" || -L "$update_lock_file" ]]; then
    path_is_safe_file "$update_lock_file" "$omanome_state_dir" || die "refusing uninstall: update lock path is unsafe"
  fi
  if [[ -e "$transaction_file" || -L "$transaction_file" ]]; then
    path_is_safe_file "$transaction_file" "$transaction_dir" || die "refusing uninstall: transaction journal path is unsafe"
    [[ -f "$transaction_file" ]] || die "refusing uninstall: transaction journal is not a regular file"
    uninstall_transaction_pending=1
  fi
}

uninstall_plan_cmd() {
  local dry_run="$1"
  local plugin_exists=false state_exists=false cache_exists=false companion_exists=false config_exists=false
  [[ -e "$installed_plugin_dir" || -L "$installed_plugin_dir" ]] && plugin_exists=true
  [[ -e "$omanome_state_dir" || -L "$omanome_state_dir" ]] && state_exists=true
  [[ -e "$omanome_cache_dir" || -L "$omanome_cache_dir" ]] && cache_exists=true
  [[ -e "$companion_data_dir" || -L "$companion_data_dir" ]] && companion_exists=true
  [[ -e "$omanome_config_dir" || -L "$omanome_config_dir" ]] && config_exists=true
  jq -n \
    --arg ownership "$uninstall_ownership_status" \
    --arg manifest "$ownership_manifest" \
    --arg plugin "$installed_plugin_dir" \
    --arg state "$omanome_state_dir" \
    --arg cache "$omanome_cache_dir" \
    --arg companion "$companion_data_dir" \
    --arg config "$omanome_config_dir" \
    --arg safeMode "$omanome_config_dir/safe-mode" \
    --argjson dryRun "$(if [[ "$dry_run" -eq 1 ]]; then printf true; else printf false; fi)" \
    --argjson purge "$(if [[ "$uninstall_purge_settings" -eq 1 ]]; then printf true; else printf false; fi)" \
    --argjson pending "$(if [[ "$uninstall_transaction_pending" -eq 1 ]]; then printf true; else printf false; fi)" \
    --argjson omarchy "$(if has omarchy; then printf true; else printf false; fi)" \
    --argjson pluginExists "$plugin_exists" \
    --argjson stateExists "$state_exists" \
    --argjson cacheExists "$cache_exists" \
    --argjson companionExists "$companion_exists" \
    --argjson configExists "$config_exists" \
    '{schemaVersion:1,dryRun:$dryRun,purgeSettings:$purge,ownership:{status:$ownership,manifest:$manifest},transaction:{pending:$pending},targets:{plugin:{path:$plugin,exists:$pluginExists},state:{path:$state,exists:$stateExists},cache:{path:$cache,exists:$cacheExists},companion:{path:$companion,exists:$companionExists},config:{path:$config,exists:$configExists}},actions:([{action:"stop-owned-processes",owner:"io.omanome.shell"}] + (if $omarchy then [{action:"remove-omarchy-plugin",target:$plugin}] else [] end) + [{action:"remove-directory",target:$plugin},{action:"remove-directory",target:$state},{action:"remove-directory",target:$cache},{action:"remove-directory",target:$companion}] + (if $purge then [{action:"remove-directory",target:$config}] else [{action:"remove-file",target:$safeMode}] end))}'
}

json_atomic_write() {
  local path="$1" content="$2" parent temporary
  parent="$(dirname -- "$path")"
  path_is_safe_directory "$parent" || die "refusing unsafe JSON parent directory: $parent"
  path_is_safe_file "$path" || die "refusing unsafe JSON destination: $path"
  temporary="$path.tmp.$$"
  path_is_safe_file "$temporary" "$parent" || die "refusing unsafe JSON temporary path: $temporary"
  [[ ! -e "$temporary" && ! -L "$temporary" ]] || die "refusing to replace an existing JSON temporary path: $temporary"
  printf '%s\n' "$content" >"$temporary"
  chmod 600 -- "$temporary"
  path_is_safe_file "$path" || { safe_remove_file "$temporary" "$parent"; die "refusing unsafe JSON destination: $path"; }
  mv -f -- "$temporary" "$path"
}

transaction_update() {
  local phase="$1" reason="${2:-}" snapshot="${3:-}" version="${4:-}" commit="${5:-}"
  ensure_dirs
  local current='{}'
  if [[ -f "$transaction_file" ]]; then
    current="$(jq -c 'if type == "object" then . else {} end' "$transaction_file" 2>/dev/null || printf '{}')"
  fi
  local updated
  updated="$(jq -c \
    --arg phase "$phase" \
    --arg reason "$reason" \
    --arg snapshot "$snapshot" \
    --arg version "$version" \
    --arg commit "$commit" \
    --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    '.schemaVersion = 1 | .phase = $phase | .updatedAt = $at | .reason = $reason
     | if $snapshot != "" then .snapshot = $snapshot else . end
     | if $version != "" then .targetVersion = $version else . end
     | if $commit != "" then .targetCommit = $commit else . end' <<<"$current")"
  json_atomic_write "$transaction_file" "$updated"
}

transaction_begin() {
  local id="$1" channel="$2" current_version="$3" current_commit="$4" snapshot="$5"
  ensure_dirs
  local content
  content="$(jq -n \
    --arg id "$id" \
    --arg channel "$channel" \
    --arg version "$current_version" \
    --arg commit "$current_commit" \
    --arg snapshot "$snapshot" \
    --arg startedAt "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    --arg pluginPath "$installed_plugin_dir" \
    --arg configPath "$(config_file)" \
    '{schemaVersion:1,id:$id,phase:"prepared",startedAt:$startedAt,updatedAt:$startedAt,channel:$channel,currentVersion:$version,currentCommit:$commit,snapshot:$snapshot,pluginPath:$pluginPath,configPath:$configPath}')"
  json_atomic_write "$transaction_file" "$content"
}

transaction_finalize() {
  local final_phase="$1" reason="${2:-}" id="unknown"
  [[ -f "$transaction_file" ]] || return 0
  id="$(jq -r '.id // "unknown"' "$transaction_file" 2>/dev/null || printf 'unknown')"
  transaction_update "$final_phase" "$reason"
  if [[ "$id" != "unknown" && "$id" =~ ^[A-Za-z0-9._-]+$ ]]; then
    cp -p -- "$transaction_file" "$transaction_history_dir/$id.json"
    chmod 600 -- "$transaction_history_dir/$id.json"
  fi
  safe_remove_file "$transaction_file" "$transaction_dir"
}

transaction_status_cmd() {
  if [[ -f "$transaction_file" ]]; then jq . "$transaction_file"; else jq -n '{active:false}'; fi
}

backup_config() {
  local current
  current="$(config_file)"
  if [[ -f "$current" ]]; then
    cp -p -- "$current" "$current.bak.$(date +%s)"
  fi
}

sanitize_status_json() {
  jq -c '
    def scrub_event($value):
      if ($value | type) == "object" then
        ($value | del(.serial, .serialNumber, .serial_number, .address, .mac, .bluetoothAddress, .bluetooth_address, .path, .devpath, .devPath, .phys, .uniq, .uniqueId, .unique_id))
      else null end;
    del(.. | .serial?, .serialNumber?, .serial_number?, .address?, .mac?, .bluetoothAddress?, .bluetooth_address?, .devpath?, .devPath?, .phys?, .uniq?, .uniqueId?, .unique_id?)
    | if (.keyboards | type) == "array" then
        .keyboards = [.keyboards[] | {category:(.category // "external"),classification:(.classification // .formFactorRelation // "unknown"),transport:(.transport // "unknown"),connected:(.connected == true),behavior:(.behavior // "generic"),ignored:(.ignored == true),capabilities:(.capabilities // {})}]
      else . end
    | if (.inputDevices | type) == "object" then
        .inputDevices = (.inputDevices
          | .mapping = (if (.mapping | type) == "array" then [.mapping[] | {role:(.role // "unknown"),output:(.output // "automatic")}] else [] end)
          | .lastEvent = scrub_event(.lastEvent)
          | .hotplug = (if (.hotplug | type) == "object" then {available:(.hotplug.available == true),lastEvent:(.hotplug.lastEvent // ""),lastAction:(.hotplug.lastAction // "")} else .hotplug end))
      else . end
    | if (.inputMapping | type) == "object" then
        .inputMapping = (.inputMapping
          | .plan = (if (.plan | type) == "array" then [.plan[] | {role:(.role // "unknown"),output:(.output // "automatic"),reason:(.reason // ""),present:(.present != false),transform:(.transform // 0)}] else [] end)
          | .explanation = [])
      else . end
    | if (.keyboardTransition | type) == "object" then
        .keyboardTransition = (.keyboardTransition | .event = (if (.event | type) == "object" then (.event | .deviceIds = []) else null end) | .lastEvent = scrub_event(.lastEvent))
      else . end
    | .schemaVersion = (.schemaVersion // 1)
    | .privacy = ((.privacy // {}) + {bluetoothMacEmitted:false,serialsEmitted:false,ephemeralPathsEmitted:false,typedTextLogged:false})'
}

status_cmd() {
  local json=0
  for argument in "$@"; do [[ "$argument" == "--json" ]] && json=1; done
  if has omarchy-shell; then
    local result
    if result="$(omarchy-shell "$plugin_id" status 2>/dev/null)" && [[ -n "$result" ]]; then
      local sanitized=""
      if sanitized="$(printf '%s\n' "$result" | sanitize_status_json 2>/dev/null)"; then
        result="$sanitized"
      fi
      if [[ "$json" -eq 1 ]]; then
        printf '%s\n' "$result" | jq -c 'if type == "object" then . else {serviceStatus:.} end' 2>/dev/null || jq -n --arg status "$result" '{schemaVersion:1,serviceStatus:$status,privacy:{bluetoothMacEmitted:false,serialsEmitted:false,typedTextLogged:false}}'
      else
        printf '%s\n' "$result" | jq . 2>/dev/null || printf '%s\n' "$result"
      fi
      return 0
    fi
  fi
  local config_path
  config_path="$(config_file)"
  if [[ "$json" -eq 1 ]]; then
    jq -n \
    --arg version "$(manifest_value version)" \
    --arg config "$config_path" \
    --arg plugin "$installed_plugin_dir" \
    --arg shell "not running" \
    --arg transaction "$(if [[ -f "$transaction_file" ]]; then jq -r '.phase // "unknown"' "$transaction_file" 2>/dev/null || printf 'unknown'; else printf 'none'; fi)" \
    --argjson installed "$(if [[ -d "$installed_plugin_dir" ]]; then printf true; else printf false; fi)" \
    --argjson safeMode "$(if [[ -f "$omanome_config_dir/safe-mode" ]]; then printf true; else printf false; fi)" \
    --argjson configJson "$(if [[ -f "$config_path" ]]; then jq -c . "$config_path" 2>/dev/null || printf '{}'; else jq -c . "$repo_dir/config/defaults.json" 2>/dev/null || printf '{}'; fi)" \
    '{schemaVersion:1,version:$version,service:$shell,configPath:$config,pluginPath:$plugin,installed:$installed,safeMode:$safeMode,transaction:$transaction,enabled:true,suspended:false,profile:($configJson.adaptive.profile // "auto"),mode:"unknown",effectiveMode:"unknown",transitioning:false,keyboardState:"unknown",keyboardStable:false,privacy:{bluetoothMacEmitted:false,serialsEmitted:false,typedTextLogged:false}}'
    return 0
  fi
  jq -n \
    --arg version "$(manifest_value version)" \
    --arg config "$config_path" \
    --arg plugin "$installed_plugin_dir" \
    --arg shell "not running" \
    --argjson installed "$(if [[ -d "$installed_plugin_dir" ]]; then printf true; else printf false; fi)" \
    --argjson configJson "$(if [[ -f "$config_path" ]]; then jq -c . "$config_path" 2>/dev/null || printf '{}'; else jq -c . "$repo_dir/config/defaults.json" 2>/dev/null || printf '{}'; fi)" \
    '{schemaVersion:1,version:$version,service:$shell,configPath:$config,pluginPath:$plugin,installed:$installed,enabled:true,suspended:false,profile:($configJson.adaptive.profile // "auto"),mode:"unknown",effectiveMode:"unknown",transitioning:false,keyboardState:"unknown",keyboardStable:false,privacy:{bluetoothMacEmitted:false,serialsEmitted:false,typedTextLogged:false}}'
}

# The service owns runtime truth. Keep the CLI on the same IPC boundary as
# the bar and Settings instead of probing hardware a second time or writing
# transient mode state to disk.
service_status_json() {
  local result
  has omarchy-shell || return 1
  result="$(omarchy-shell "$plugin_id" status 2>/dev/null)" || return 1
  [[ -n "$result" ]] || return 1
  jq -ce 'select(type == "object")' <<<"$result" 2>/dev/null
}

service_control_cmd() {
  local action="$1" method="" json=0
  shift || true
  for argument in "$@"; do [[ "$argument" == "--json" ]] && json=1; done
  case "$action" in
    enable|on) method="enable"; action="enable" ;;
    disable|off) method="disable"; action="disable" ;;
    suspend) method="suspend" ;;
    resume) method="resume" ;;
    *) die "unknown runtime control action: $action" ;;
  esac

  local result="" call_ok=0
  if has omarchy-shell && result="$(omarchy-shell "$plugin_id" "$method" 2>/dev/null)"; then
    local last_line="${result##*$'\n'}"
    last_line="${last_line%$'\r'}"
    [[ "$last_line" == "ok" ]] && call_ok=1
  else
    result="omarchy-shell is unavailable"
  fi

  if [[ "$json" -eq 1 ]]; then
    jq -n --arg action "$action" --arg result "$result" --arg service "$plugin_id" --argjson ok "$(if [[ "$call_ok" -eq 1 ]]; then printf true; else printf false; fi)" \
      '{schemaVersion:1,action:$action,ok:$ok,result:$result,service:$service,privacy:{typedTextLogged:false}}'
  elif [[ "$call_ok" -eq 1 ]]; then
    case "$action" in
      enable) say "Omanome master toggle enabled." ;;
      disable) say "Omanome master toggle disabled; input state was released by the service." ;;
      suspend) say "Omanome enhancements suspended; the service remains available." ;;
      resume) say "Omanome enhancements resumed." ;;
    esac
  else
    say "omanome: failed to $action Omanome runtime: $result" >&2
  fi
  [[ "$call_ok" -eq 1 ]] || return "$EX_NETWORK"
}

mode_info_cmd() {
  local json=0
  for argument in "$@"; do [[ "$argument" == "--json" ]] && json=1; done

  local service='{}' source="service" config='{}' service_result=""
  if service_result="$(service_status_json 2>/dev/null)"; then service="$service_result"; else source="fallback"; service='{}'; fi
  if [[ -f "$(config_file)" ]]; then
    config="$(jq -c . "$(config_file)" 2>/dev/null || printf '{}')"
  else
    config="$(jq -c . "$repo_dir/config/defaults.json" 2>/dev/null || printf '{}')"
  fi

  local payload
  payload="$(jq -n \
    --arg version "$(manifest_value version)" \
    --arg source "$source" \
    --argjson service "$service" \
    --argjson config "$config" '
      def mode_id:
        tostring | ascii_downcase | gsub("[_[:space:]]+"; "-")
        | if . == "automatic" or . == "default" then "auto" else . end;
      def mode_label($value):
        if $value == "auto" then "Auto"
        elif $value == "desktop" then "Desktop"
        elif $value == "tablet" then "Tablet"
        elif $value == "hybrid" then "Hybrid"
        elif $value == "unknown" then "Unknown"
        else ($value | tostring) end;
      def useful_text($value):
        ($value | tostring) as $text
        | if $value == null or $text == "" or (["", "idle", "unknown", "not-evaluated"] | index($text) != null)
          then null else $text end;
      def service_bool($value): if $source == "service" then ($value == true) else null end;
      ($service | if type == "object" then . else {} end) as $s
      | ($config | if type == "object" then . else {} end) as $c
      | (($s.profile // $c.adaptive.profile // $s.requestedMode // $c.general.mode // "auto") | mode_id) as $policyCandidate
      | (if (["auto", "desktop", "tablet", "hybrid"] | index($policyCandidate)) == null then "auto" else $policyCandidate end) as $policyId
      | (($s.effectiveMode // (if $source == "service" then $s.mode else null end) // "unknown") | mode_id) as $effectiveCandidate
      | (if (["desktop", "tablet", "hybrid", "unknown"] | index($effectiveCandidate)) == null then "unknown" else $effectiveCandidate end) as $effectiveId
      | (($s.posture.signals.posture // $s.posture.posture // $s.tabletMode.mode // $effectiveId) | mode_id) as $postureCandidate
      | (if (["desktop", "tablet", "hybrid", "unknown"] | index($postureCandidate)) == null then $effectiveId else $postureCandidate end) as $postureId
      | (($s.keyboardState // $s.keyboardTransition.phase // "") | tostring | ascii_downcase) as $keyboardPhase
      | (if $source == "fallback" then "unknown"
         elif $keyboardPhase == "disconnected" then "detached"
         elif $keyboardPhase == "disconnecting" then "disconnecting"
         elif $keyboardPhase == "connecting" then "connecting"
         elif $keyboardPhase == "detached" then "detached"
         elif $keyboardPhase == "connected" then "connected"
         elif $s.physicalKeyboard == true or (($s.physicalKeyboardCount // 0) > 0) then "connected"
         else "detached" end) as $keyboard
      | (if $source == "service" then (($s.hasTouchscreen == true) or (($s.touch.count // 0) > 0)) else null end) as $touchPresent
      | (if $touchPresent == null then "unknown" elif $touchPresent then "present" else "absent" end) as $touch
      | (($s.dockedMode.externalMonitorCount // $s.externalMonitorCount // 0) | tonumber) as $externalCount
      | (if $source == "service" then (($s.dockedMode.externalMonitor == true) or ($s.externalMonitor == true) or $externalCount > 0) else null end) as $externalMonitor
      | (useful_text($s.dockedMode.reason)) as $dockedReason
      | (useful_text($s.keyboardTransition.modeReason)) as $keyboardReason
      | (useful_text($s.tabletMode.reason)) as $tabletReason
      | (useful_text($s.modeTransition.reason)) as $transitionReason
      | (if $source == "fallback" then "Omanome service is not running"
         elif $s.safeMode == true then "Safe Mode is active"
         elif $s.enabled == false then "Omanome master toggle is off"
         elif $s.suspended == true then "Omanome is suspended"
         elif $s.dockedMode.active == true and $dockedReason != null then $dockedReason
         elif $transitionReason != null then $transitionReason
         elif $keyboardReason != null then $keyboardReason
         elif $tabletReason != null then $tabletReason
         elif $policyId != "auto" then (mode_label($policyId) + " profile selected")
         else "automatic posture and capability policy" end) as $reason
      | {
          schemaVersion: 1,
          version: $version,
          source: $source,
          policy: mode_label($policyId),
          policyId: $policyId,
          effective: mode_label($effectiveId),
          effectiveMode: $effectiveId,
          keyboard: $keyboard,
          keyboardState: $keyboard,
          posture: mode_label($postureId),
          postureId: $postureId,
          touch: $touch,
          touchPresent: $touchPresent,
          externalMonitor: $externalMonitor,
          externalMonitorCount: (if $source == "service" then $externalCount else null end),
          reason: $reason,
          enabled: (if $source == "service" then ($s.enabled == true) else null end),
          suspended: (if $source == "service" then ($s.suspended == true) else null end),
          transitioning: (if $source == "service" then ($s.transitioning == true) else null end),
          docked: {
            active: (if $source == "service" then ($s.dockedMode.active == true) else null end),
            phase: (if $source == "service" then ($s.dockedMode.phase // "undocked") else "unknown" end)
          },
          keyboardDetails: {
            connected: service_bool(($s.physicalKeyboard == true) or (($s.physicalKeyboardCount // 0) > 0)),
            physical: service_bool($s.physicalKeyboard),
            detachable: service_bool($s.detachableKeyboard),
            bluetooth: service_bool($s.bluetoothKeyboard),
            stable: (if $source == "service" then ($s.keyboardStable != false) else null end),
            count: (if $source == "service" then ($s.physicalKeyboardCount // $s.keyboardTransition.connectedCount // 0) else null end)
          },
          preview: (if $source == "service" then ($s.adaptivePreview // {active:false}) else {active:false} end),
          privacy: {bluetoothMacEmitted:false, serialsEmitted:false, ephemeralPathsEmitted:false, typedTextLogged:false}
        }' )"

  if [[ "$json" -eq 1 ]]; then
    printf '%s\n' "$payload"
  else
    jq -r '"Policy: \(.policy)\nEffective: \(.effective)\nKeyboard: \(.keyboard)\nPosture: \(.posture)\nTouch: \(.touch)\nExternal monitor: " + (if .externalMonitor == null then "unknown" elif .externalMonitor then "yes" else "no" end) + "\nReason: \(.reason)"' <<<"$payload"
  fi
}

