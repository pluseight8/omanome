device_info_cmd() {
  local device_id="" json=0 argument graph config payload
  for argument in "$@"; do
    case "$argument" in
      --json) json=1 ;;
      --*) die "unsupported device info option: $argument" ;;
      *) [[ -z "$device_id" ]] || die "device info accepts one device id"; device_id="$argument" ;;
    esac
  done
  [[ -n "$device_id" ]] || die "device info requires a Device Graph id"
  device_id_is_safe "$device_id" || die "device info requires a sanitized Device Graph id"
  graph="$(device_graph_payload)"
  if [[ -f "$(config_file)" ]]; then config="$(jq -c . "$(config_file)" 2>/dev/null || printf '{}')"; else config="$(jq -c . "$repo_dir/config/defaults.json")"; fi
  payload="$(jq -n --arg id "$device_id" --argjson graph "$graph" --argjson config "$config" '
    def opaque:
      if type == "string" and test("^(device:[a-z0-9-]+:[0-9a-f]{16}|display:[0-9a-f]{16})$") then . else "" end;
    def output_id($value): ($value // "") | if type == "string" and test("^display:[0-9a-f]{16}$") then . else "" end;
    def output_present($outputs;$value): any($outputs[]?; .id == $value);
    def mapping($value):
      ($value // {}) as $m
      | if ($m | type) != "object" then null else
          {outputId:output_id($m.outputId // $m.output_id),
           offset:{x:($m.offset.x // $m.offsetX // 0),y:($m.offset.y // $m.offsetY // 0)},
           scale:{x:($m.scale.x // $m.scaleX // 1),y:($m.scale.y // $m.scaleY // 1)},
           rotation:($m.rotation // 0),
           axis:($m.axis // {swapped:false,invertX:false,invertY:false})}
          | if .outputId == "" then null else . end
        end;
    ($graph.graph // {}) as $g
    | ([($g.nodes // [])[], ($g.outputs // [])[]] | map(select(.id == $id)) | .[0]) as $node
    | ($config.deviceProfiles // {}) as $dp
    | ($dp.profiles[$id] // null) as $profile
    | ([($dp.calibrations.entries // {}) | to_entries[]? | .value | select(.deviceId == $id)] | map({id:(.id // ""),kind:(.kind // "unknown"),status:(.status // "unknown"),outputId:output_id(.outputId),mapping:mapping(.mapping),lastKnownGood:mapping(.lastKnownGood)})) as $calibrations
    | {schemaVersion:1,deviceId:$id,present:($node != null),node:(if $node == null then null else $node end),
       relationships:([($g.relationships // [])[] | select(.from == $id or .to == $id)]),
       profile:(if ($profile | type) != "object" then null else {enabled:($profile.enabled != false),name:($profile.name // ""),touch:{enabled:($profile.touch.enabled != false),mappingOutput:output_id($profile.touch.mappingOutput),calibrationId:($profile.touch.calibrationId // ""),gestureProfile:($profile.touch.gestureProfile // "auto"),edgeSensitivity:($profile.touch.edgeSensitivity // "auto"),palmPolicy:($profile.touch.palmPolicy // "auto")},stylus:{enabled:($profile.stylus.enabled != false),mappingOutput:output_id($profile.stylus.mappingOutput),calibrationId:($profile.stylus.calibrationId // ""),pressureCurve:($profile.stylus.pressureCurve // "linear"),handedness:($profile.stylus.handedness // "auto"),cursor:($profile.stylus.cursor // "auto"),palmRejection:($profile.stylus.palmRejection // "auto"),handwriting:($profile.stylus.handwriting // "auto"),buttonMap:($profile.stylus.buttonMap // {})},keyboard:{enabled:($profile.keyboard.enabled != false),layout:($profile.keyboard.layout // "auto"),oskPolicy:($profile.keyboard.oskPolicy // "auto"),relation:($profile.keyboard.relation // "auto")}} end),
       calibrations:$calibrations,
       health:{graphAvailable:($g.health.available == true),nodePresent:($node != null),connected:($node.connected == true),mappingOutputsPresent:all($calibrations[]?; . as $calibration | ($calibration.outputId == "" or output_present($g.outputs;$calibration.outputId))),customCalibrationCount:($calibrations | length)},
       privacy:{rawHardwareIdentifiersEmitted:false,serialsEmitted:false,bluetoothMacEmitted:false,eventNodesEmitted:false}}')"
  if [[ "$json" -eq 1 ]]; then
    printf '%s\n' "$payload"
  else
    jq -r '"Device: \(.deviceId)\nPresent: " + (if .present then "yes" else "no" end) + "\nCategory: " + (.node.category // "unknown") + "\nTransport: " + (.node.transport // "unknown") + "\nConnected: " + (if .health.connected then "yes" else "no" end) + "\nMapped output: " + ((.node.mappedOutput // .profile.touch.mappingOutput // .profile.stylus.mappingOutput // "automatic") | if . == "" then "automatic" else . end) + "\nCalibrations: " + ((.calibrations | length) | tostring)' <<<"$payload"
  fi
}

