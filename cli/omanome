device_mutation_cmd() {
  local action="$1" device_id="" json=0 accept=0 argument result
  shift || true
  for argument in "$@"; do
    case "$argument" in
      --json) json=1 ;;
      --yes) accept=1 ;;
      --*) die "unsupported device $action option: $argument" ;;
      *) [[ -z "$device_id" ]] || die "device $action accepts one device id"; device_id="$argument" ;;
    esac
  done
  [[ -n "$device_id" ]] || die "device $action requires a Device Graph id"
  device_id_is_safe "$device_id" || die "device $action requires a sanitized Device Graph id"
  if [[ "$action" == "reset" && "$accept" -ne 1 ]]; then
    read -r -p "Remove Omanome profile and calibration metadata for $device_id? [y/N] " argument
    [[ "$argument" == "y" || "$argument" == "Y" ]] || exit 0
  fi
  ensure_dirs
  if result="$(python3 "$config_tool" device "$action" "$(config_file)" "$device_id" --json)"; then
    if has omarchy-shell; then omarchy-shell "$plugin_id" reload >/dev/null 2>&1 || true; fi
    if [[ "$json" -eq 1 ]]; then printf '%s\n' "$result"; else jq -r '"Device \(.deviceId): " + .action + " complete" + (if .calibrationsRemoved != null then (" (" + (.calibrationsRemoved|tostring) + " calibration(s) removed)") elif .restored != null then (" (" + (.restored|length|tostring) + " calibration(s) restored)") else "" end)' <<<"$result"; fi
  else
    [[ -n "$result" ]] && { [[ "$json" -eq 1 ]] && printf '%s\n' "$result" || printf '%s\n' "$result" >&2; }
    return "$EX_CONFIG"
  fi
}

hardware_setup_cmd() {
  local operation="${1:-list}" json=0 setup_id="" argument result graph payload
  shift || true
  for argument in "$@"; do
    case "$argument" in
      --json) json=1 ;;
      --*) die "unsupported hardware-setup option: $argument" ;;
      *) [[ -z "$setup_id" ]] || die "hardware-setup accepts one setup name"; setup_id="$argument" ;;
    esac
  done
  case "$operation" in
    list|status|apply) ;;
    *) usage >&2; die "unknown hardware-setup operation: $operation" ;;
  esac
  ensure_dirs
  if [[ "$operation" == "apply" && -z "$setup_id" ]]; then die "hardware-setup apply requires a setup name"; fi
  if [[ "$operation" != "apply" && -n "$setup_id" ]]; then die "hardware-setup $operation does not accept a setup name"; fi
  if [[ "$operation" == "apply" ]]; then
    result="$(python3 "$config_tool" hardware-setup apply "$(config_file)" "$setup_id" --json)" || { [[ -n "$result" ]] && printf '%s\n' "$result" >&2; return "$EX_CONFIG"; }
    if has omarchy-shell; then omarchy-shell "$plugin_id" reload >/dev/null 2>&1 || true; fi
    if [[ "$json" -eq 1 ]]; then printf '%s\n' "$result"; else jq -r '"Hardware setup selected: \(.selected)"' <<<"$result"; fi
    return 0
  fi
  result="$(python3 "$config_tool" hardware-setup "$operation" "$(config_file)" --json)" || { [[ -n "$result" ]] && printf '%s\n' "$result" >&2; return "$EX_CONFIG"; }
  if [[ "$operation" == "status" ]]; then
    graph="$(device_graph_payload)"
    payload="$(jq -n --argjson status "$result" --argjson graph "$graph" '$status + {runtime:{source:($graph.source // "unavailable"),graphAvailable:($graph.graph.health.available == true),selected:(($graph.hardwarePolicies.selected // null)),resolvedSource:(($graph.hardwarePolicies.source // null)),preferredAdaptiveProfile:(($graph.hardwarePolicies.preferredAdaptiveProfile // null)),reason:(($graph.hardwarePolicies.reason // null))}}')"
  else
    payload="$result"
  fi
  if [[ "$json" -eq 1 ]]; then printf '%s\n' "$payload"; else jq -r 'if .setups then (.setups[] | "\(.id): \(.label) (adaptive=\(.preferredAdaptiveProfile))") else "Selected: \(.setup.label)\nAdaptive profile: \(.setup.preferredAdaptiveProfile)\nMatch policy: \(.matchPolicy.mode)\nRuntime source: \(.runtime.source)\nRuntime setup: " + (.runtime.selected // "unknown") end' <<<"$payload"; fi
}

input_info_cmd() {
  local native_path="${OMANOME_INPUT_BIN:-}" native_version="" native_protocol="" probe='{}' devices='{}'
  local -a candidates=()
  [[ -n "$native_path" ]] && candidates+=("$native_path")
  candidates+=("$repo_dir/input/omanome-input/omanome-input" "$repo_dir/input/omanome-input/target/release/omanome-input" "$repo_dir/input/omanome-input/target/debug/omanome-input")
  if [[ -z "$native_path" ]]; then
    for native_path in "${candidates[@]}"; do
      if [[ -x "$native_path" ]]; then break; fi
      native_path=""
    done
  fi
  if [[ -n "$native_path" && -x "$native_path" ]]; then
    native_version="$($native_path --version 2>/dev/null | head -n 1 || true)"
    native_protocol="$($native_path --protocol 2>/dev/null | head -n 1 || true)"
    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && has timeout; then
      local runtime_output caps status
      runtime_output="$(timeout --signal=TERM 3 "$native_path" </dev/null 2>/dev/null || true)"
      caps="$(jq -c 'select(.type == "input.capabilities")' <<<"$runtime_output" | tail -n 1 || true)"
      status="$(jq -c 'select(.type == "input.status")' <<<"$runtime_output" | tail -n 1 || true)"
      if [[ -n "$caps" ]]; then
        local status_json='{}'
        [[ -n "$status" ]] && status_json="$status"
        probe="$(jq -n --argjson capabilities "$caps" --argjson status "$status_json" '{status:"runtime-probed",capabilities:$capabilities,statusRecord:$status}')"
      else
        probe='{"status":"runtime-unavailable","reason":"native helper did not expose a Wayland capability record"}'
      fi
    else
      probe='{"status":"not-run","reason":"Wayland session unavailable"}'
    fi
  else
    native_path=""
    probe='{"status":"not-built","reason":"native helper binary is not installed or built"}'
  fi
  if has hyprctl; then devices="$(hyprctl devices -j 2>/dev/null || printf '{}')"; fi
  jq -e . >/dev/null 2>&1 <<<"$devices" || devices='{}'
  local keyboard_count touchscreen_count stylus_count
  keyboard_count="$(jq '[.keyboards // [] | .[] | select(((.type // "") | ascii_downcase) as $type | ($type != "consumer-control" and $type != "power-button"))] | length' <<<"$devices")"
  touchscreen_count="$(jq '[.touch // .touchDevices // .touchdevices // []] | length' <<<"$devices")"
  stylus_count="$(jq '[.tablets // .tabletTools // .tablettools // []] | length' <<<"$devices")"
  jq -n \
    --arg version "$(manifest_value version)" \
    --arg protocol "${native_protocol:-omanome-input protocol unavailable}" \
    --arg nativeVersion "${native_version:-native helper metadata unavailable}" \
    --arg path "${native_path:-unavailable}" \
    --argjson probe "$probe" \
    --argjson wtype "$(if has wtype; then printf true; else printf false; fi)" \
    --argjson keyboardCount "${keyboard_count:-0}" \
    --argjson touchscreenCount "${touchscreen_count:-0}" \
    --argjson stylusCount "${stylus_count:-0}" \
    '{schemaVersion:1,version:$version,nativeBackend:{status:(if $path == "unavailable" then "unavailable" else "built" end),path:$path,version:$nativeVersion,protocol:$protocol,probe:$probe},protocolSupport:{seat:($probe.capabilities.seat // "runtime-probe"),virtualKeyboard:($probe.capabilities.virtualKeyboard // "runtime-probe"),textInput:($probe.capabilities.textInput // "runtime-probe"),inputMethod:($probe.capabilities.inputMethod // "runtime-probe"),textFocus:($probe.capabilities.textFocusProvider // "runtime-probe"),keymap:($probe.capabilities.keymap // "runtime-probe"),tablet:($probe.capabilities.tablet // "runtime-probe"),stylusPressure:($probe.capabilities.stylusPressure // false),stylusTilt:($probe.capabilities.stylusTilt // false),stylusDistance:($probe.capabilities.stylusDistance // false),stylusRotation:($probe.capabilities.stylusRotation // false),stylusEraser:($probe.capabilities.stylusEraser // false),stylusButtons:($probe.capabilities.stylusButtons // false)},osk:{ui:"available",virtualKeyboard:($probe.capabilities.virtualKeyboard // "runtime-probe"),textInputFocus:($probe.capabilities.textFocusProvider // "runtime-probe"),inputMethod:($probe.capabilities.inputMethod // "runtime-probe"),autoShow:($probe.capabilities.inputMethod == "v2"),autoShowMode:(if $probe.capabilities.inputMethod == "v2" then "native" elif $wtype then "fallback" else "unavailable" end),reason:(if $probe.capabilities.inputMethod == "v2" then "native text focus events" else "requires compositor text-input/input-method support" end)},physicalKeyboard:{count:$keyboardCount,detected:($keyboardCount > 0)},touchscreen:{count:$touchscreenCount},stylus:{count:$stylusCount,nativeTablet:($probe.capabilities.tablet // "runtime-probe"),pressure:($probe.capabilities.stylusPressure // false),tilt:($probe.capabilities.stylusTilt // false),distance:($probe.capabilities.stylusDistance // false),rotation:($probe.capabilities.stylusRotation // false),eraser:($probe.capabilities.stylusEraser // false),buttons:($probe.capabilities.stylusButtons // false),proximity:($probe.capabilities.stylusProximity // false)},handwriting:{ink:($probe.capabilities.handwritingInk // false),provider:($probe.capabilities.handwritingProvider // "none"),recognition:($probe.capabilities.handwritingRecognition // "unavailable"),languages:[],cloud:($probe.capabilities.handwritingCloud // false)},fallback:{wtype:$wtype,policy:"explicit-only",processPerKey:false},privacy:{typedTextLogged:false,surroundingTextPersisted:false,hardwareIdentifiersEmitted:false}}'
}

