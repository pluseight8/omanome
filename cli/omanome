#!/usr/bin/env bash
set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_dir="$(cd -- "$script_dir/.." && pwd -P)"
user_home="${HOME:-}"
config_home="${XDG_CONFIG_HOME:-$user_home/.config}"
state_home="${XDG_STATE_HOME:-$user_home/.local/state}"
data_home="${XDG_DATA_HOME:-$user_home/.local/share}"
omanome_config_dir="$config_home/omanome"
omanome_state_dir="$state_home/omanome"
omanome_cache_dir="${XDG_CACHE_HOME:-$user_home/.cache}/omanome"
plugin_id="io.omanome.shell"
repository_url="https://github.com/pluseight8/omanome.git"
repository_manifest_url="https://raw.githubusercontent.com/pluseight8/omanome/main/manifest.json"
installed_plugin_dir="$config_home/omarchy/plugins/$plugin_id"
rollback_dir="$omanome_state_dir/rollback"
manifest_path="$repo_dir/manifest.json"
companion_root="$repo_dir/hypr/omanome-hypr"
companion_manifest="$companion_root/compatibility.json"
companion_data_dir="$data_home/omanome/companion"
companion_artifact="$companion_data_dir/omanome-hypr.so"
companion_state_dir="$omanome_state_dir/companion"
companion_pending_marker="$companion_state_dir/load.pending"
companion_disabled_marker="$companion_state_dir/disabled"
companion_lifecycle_file="$companion_state_dir/lifecycle.json"
companion_lifecycle_log="$companion_state_dir/lifecycle.log"
companion_backup_dir="$companion_state_dir/artifacts"

say() { printf '%s\n' "$*"; }
die() { printf 'omanome: %s\n' "$*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'EOF'
Usage: omanome <command> [options]

Commands:
  status                 Show shell/service status without clipboard contents
  doctor                 Check Omarchy, Hyprland, Wayland and plugin safety
  logs                  Show recent user-session logs (payloads are not added)
  reload                Ask the existing Omarchy shell to rescan plugins
  enable | disable       Enable or disable only the Omanome plugin
  safe-mode              Disable Omanome and create a safe-mode marker
  setup                  Print optional dependencies and prepare user dirs
  install                Install this plugin from the official GitHub repo
  export-config [file]   Print or export the versioned config
  import-config <file>   Validate and import a config, keeping a backup
  reset [--yes]          Reset Omanome's config only
  update --check         Check the installed checkout and compatibility
  update                 Create rollback point, then use Omarchy plugin update
  rollback               Restore the newest Omanome rollback point
  uninstall [--purge-settings] [--yes]
  version                Print Omanome version
  stylus-info            Print capability inventory without changing input
  touch-info             Print touchscreen inventory without changing input
  sensor-info            Print rotation sensor backend diagnostics
  companion status       Print optional Hyprland companion state
  companion doctor       Check companion headers, ABI and safe loading
  companion build        Build the companion in the user checkout
  companion install      Build and copy the companion to user data
  companion rebuild      Rebuild and reinstall the companion
  companion enable       Load a compatible user-owned companion
  companion disable      Unload the optional companion
  companion recover      Disable, restore the newest companion backup, and clear pending state
  effects                Print effect and preview backend capabilities
  benchmark              Print lightweight runtime/render diagnostics
  devices                Print Hyprland's device inventory
EOF
}

manifest_value() {
  jq -r --arg key "$1" '.[$key] // empty' "$manifest_path"
}

config_file() { printf '%s/config.json\n' "$omanome_config_dir"; }

ensure_dirs() {
  mkdir -p -- "$omanome_config_dir" "$omanome_state_dir" "$omanome_cache_dir" "$rollback_dir" "$companion_state_dir" "$companion_backup_dir"
}

backup_config() {
  local current
  current="$(config_file)"
  if [[ -f "$current" ]]; then
    cp -p -- "$current" "$current.bak.$(date +%s)"
  fi
}

status_cmd() {
  if has omarchy-shell; then
    local result
    if result="$(omarchy-shell "$plugin_id" status 2>/dev/null)" && [[ -n "$result" ]]; then
      printf '%s\n' "$result" | jq . 2>/dev/null || printf '%s\n' "$result"
      return 0
    fi
  fi
  local config_path
  config_path="$(config_file)"
  jq -n \
    --arg version "$(manifest_value version)" \
    --arg config "$config_path" \
    --arg plugin "$installed_plugin_dir" \
    --arg shell "not running" \
    --argjson installed "$(if [[ -d "$installed_plugin_dir" ]]; then printf true; else printf false; fi)" \
    '{version:$version, service:$shell, configPath:$config, pluginPath:$plugin, installed:$installed}'
}

doctor_cmd() {
  local failed=0
  say "Omanome $(manifest_value version)"
  say "Repository: $repo_dir"
  if jq -e '(.kinds // []) | index("bar") != null' "$manifest_path" >/dev/null; then
    say "FAIL: manifest declares replacement bar"
    failed=1
  else
    say "OK: manifest does not declare replacement bar"
  fi

  for command_name in omarchy quickshell hyprctl wl-paste wl-copy wtype; do
    if has "$command_name"; then say "OK: $command_name -> $(command -v "$command_name")"; else say "WARN: optional/missing $command_name"; fi
  done

  if [[ -n "${OMARCHY_PATH:-}" && -f "${OMARCHY_PATH}/shell/services/PluginRegistry.qml" ]]; then
    say "OK: OMARCHY_PATH points to a Quattro shell"
  else
    say "WARN: OMARCHY_PATH is not set to an Omarchy shell in this process"
  fi

  if [[ -x /usr/lib/qt6/bin/qmllint ]]; then
    if make -C "$repo_dir" qmllint >/dev/null 2>&1; then say "OK: QML lint"; else say "WARN: QML lint reported errors; run make qmllint"; failed=1; fi
  else
    say "WARN: qmllint is not installed"
  fi

  if has omarchy && omarchy plugin validate "$repo_dir" >/dev/null 2>&1; then say "OK: Omarchy manifest validation"; else say "WARN: Omarchy plugin validation unavailable or failed"; failed=1; fi
  say "Safety: no sudo, no X11 backend, no second Quickshell, no bar replacement"
  return "$failed"
}

logs_cmd() {
  if has journalctl; then
    journalctl --user -n 120 --no-pager 2>/dev/null | rg -i 'omanome|quickshell|omarchy-shell' || true
  else
    say "journalctl is unavailable; use quickshell log from the graphical session"
  fi
}

reload_cmd() {
  has omarchy-shell || die "omarchy-shell is not installed"
  omarchy-shell shell rescanPlugins
}

enable_cmd() {
  has omarchy || die "omarchy is not installed"
  rm -f -- "$omanome_config_dir/safe-mode"
  omarchy plugin enable "$plugin_id"
  reload_cmd || true
}

disable_cmd() {
  has omarchy || die "omarchy is not installed"
  omarchy plugin disable "$plugin_id"
  reload_cmd || true
}

safe_mode_cmd() {
  ensure_dirs
  : >"$omanome_config_dir/safe-mode"
  disable_cmd || true
  companion_disable_cmd || true
  say "Omanome safe mode enabled; the standard Omarchy shell remains available."
}

companion_info_cmd() {
  [[ -x "$repo_dir/input/companion-info.sh" ]] || die "companion diagnostics are unavailable"
  "$repo_dir/input/companion-info.sh" | jq .
}

companion_runtime_abi() {
  if has hyprctl; then
    hyprctl version 2>/dev/null | sed -n 's/^Version ABI string:[[:space:]]*//p' | head -n 1
  fi
}

companion_runtime_version() {
  if has hyprctl; then
    hyprctl version 2>/dev/null | sed -n '1s/^Hyprland[[:space:]]\+//p' | awk '{print $1}'
  fi
}

companion_runtime_commit() {
  if has hyprctl; then
    hyprctl version 2>/dev/null | sed -n '1s/.*commit[[:space:]]\+\([[:alnum:]_:-]\+\).*/\1/p' | head -n 1
  fi
}

companion_timestamp() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

companion_record_event() {
  ensure_dirs
  local event="${1:-unknown}"
  local reason="${2:-}"
  printf '%s event=%s reason=%s\n' "$(companion_timestamp)" "$event" "$reason" >>"$companion_lifecycle_log"
  chmod 600 -- "$companion_lifecycle_log"
}

companion_state_update() {
  ensure_dirs
  local event="${1:-unknown}"
  local reason="${2:-}"
  local at
  at="$(companion_timestamp)"
  local current='{}'
  if [[ -f "$companion_lifecycle_file" ]]; then
    current="$(jq -c 'if type == "object" then . else {} end' "$companion_lifecycle_file" 2>/dev/null || printf '{}')"
  fi
  local temporary="$companion_lifecycle_file.tmp.$$"
  jq --arg event "$event" --arg reason "$reason" --arg at "$at" '
    .schemaVersion = 1
    | .lastEvent = $event
    | .lastEventAt = $at
    | .lastReason = $reason
    | if $event == "load-attempt" then
        .enabled = true | .loadPending = true | .lastLoadAt = $at
      elif $event == "load-success" then
        .enabled = true | .loadPending = false | .lastSuccessAt = $at | .lastLoadFailure = null
      elif $event == "load-failure" then
        .loadPending = true | .loadFailureCount = ((.loadFailureCount // 0) + 1)
        | .lastLoadFailure = {at:$at, reason:$reason}
      elif $event == "crash-detected" then
        .loadPending = true | .crashCount = ((.crashCount // 0) + 1)
        | .lastCrash = {at:$at, reason:$reason}
      elif $event == "disabled" then
        .enabled = false | .loadPending = false
      elif $event == "artifact-installed" then
        .installedAt = $at
      elif $event == "recovered" then
        .enabled = false | .loadPending = false | .lastRecoveryAt = $at
      else . end
  ' <<<"$current" >"$temporary"
  chmod 600 -- "$temporary"
  mv -f -- "$temporary" "$companion_lifecycle_file"
  companion_record_event "$event" "$reason"
}

companion_backup_artifact() {
  [[ -f "$companion_artifact" ]] || return 0
  ensure_dirs
  local stamp destination
  stamp="$(date -u +%Y%m%d-%H%M%S)"
  destination="$companion_backup_dir/$stamp"
  if [[ -e "$destination" ]]; then destination="$companion_backup_dir/${stamp}-$(date +%s%N)"; fi
  mkdir -p -- "$destination"
  install -Dm755 -- "$companion_artifact" "$destination/omanome-hypr.so"
  if [[ -f "$companion_data_dir/compatibility.json" ]]; then
    install -Dm600 -- "$companion_data_dir/compatibility.json" "$destination/compatibility.json"
  fi
  printf '%s\n' "$destination"
}

companion_artifact_verify() {
  [[ -s "$companion_artifact" ]] || { say "FAIL: companion artifact is missing or empty"; return 1; }
  if has file && ! file -b -- "$companion_artifact" | grep -Eq 'ELF.*shared object'; then
    say "FAIL: companion artifact is not an ELF shared object"
    return 1
  fi
  if has readelf && ! readelf -h -- "$companion_artifact" >/dev/null 2>&1; then
    say "FAIL: companion artifact ELF header is unreadable"
    return 1
  fi
  return 0
}

companion_doctor_cmd() {
  local failed=0
  say "Omanome companion doctor"
  if [[ ! -d "$companion_root" || ! -f "$companion_root/Makefile" ]]; then
    say "FAIL: companion source is missing from $companion_root"
    return 1
  fi
  say "OK: companion source is present"
  for build_tool in jq make g++; do
    if has "$build_tool"; then say "OK: $build_tool -> $(command -v "$build_tool")"; else say "FAIL: $build_tool is unavailable"; failed=1; fi
  done
  if has pkg-config; then
    say "OK: pkg-config -> $(command -v pkg-config)"
  else
    say "FAIL: pkg-config is unavailable"
    failed=1
  fi
  if has pkg-config && pkg-config --exists hyprland; then
    say "OK: matching Hyprland development package: $(pkg-config --modversion hyprland)"
  else
    say "WARN: matching Hyprland headers are unavailable; install them manually or let hyprpm prepare them"
  fi
  if has hyprctl; then
    say "OK: runtime Hyprland $(companion_runtime_version)"
    say "ABI: $(companion_runtime_abi || printf 'unavailable')"
    say "Commit: $(companion_runtime_commit || printf 'unavailable')"
  else
    say "WARN: hyprctl is unavailable; companion cannot be loaded in this session"
  fi
  if [[ -f "$companion_artifact" ]]; then
    say "OK: user-owned artifact $companion_artifact"
    companion_artifact_verify || failed=1
    if [[ -f "$companion_data_dir/compatibility.json" && -n "$(companion_runtime_abi)" ]]; then
      local built_abi built_version built_commit built_hash expected_hash
      built_abi="$(jq -r '.build.hyprlandAbi // .hyprland.abi // empty' "$companion_data_dir/compatibility.json" 2>/dev/null || true)"
      built_version="$(jq -r '.build.hyprlandVersion // .hyprland.version // empty' "$companion_data_dir/compatibility.json" 2>/dev/null || true)"
      built_commit="$(jq -r '.build.hyprlandCommit // .hyprland.commit // empty' "$companion_data_dir/compatibility.json" 2>/dev/null || true)"
      built_hash="$(jq -r '.build.artifactSha256 // empty' "$companion_data_dir/compatibility.json" 2>/dev/null || true)"
      expected_hash="$(sha256sum "$companion_artifact" 2>/dev/null | awk '{print $1}')"
      say "Build version: ${built_version:-unknown}"
      say "Build commit: ${built_commit:-unknown}"
      say "Build ABI: ${built_abi:-unknown}"
      say "Artifact hash: ${built_hash:-unknown}"
      if [[ -n "$built_abi" && "$built_abi" == "$(companion_runtime_abi)" ]]; then
        say "OK: artifact ABI matches the running Hyprland"
      else
        say "FAIL: artifact ABI does not match the running Hyprland; rebuild before enabling"
        failed=1
      fi
      if [[ -n "$built_version" && "$built_version" == "$(companion_runtime_version)" ]]; then
        say "OK: artifact Hyprland version matches the running compositor"
      else
        say "FAIL: artifact Hyprland version is stale; rebuild before enabling"
        failed=1
      fi
      if [[ -n "$built_hash" && -n "$expected_hash" && "$built_hash" == "$expected_hash" ]]; then
        say "OK: artifact integrity hash matches build metadata"
      else
        say "FAIL: artifact integrity hash is missing or mismatched"
        failed=1
      fi
    else
      say "WARN: artifact build metadata is missing; reinstall it with 'omanome companion install'"
      failed=1
    fi
  else
    say "INFO: companion is not installed; core Omanome remains fully available"
  fi
  if [[ -f "$companion_disabled_marker" ]]; then
    say "INFO: companion is disabled by user policy"
  fi
  if [[ -f "$companion_pending_marker" ]]; then
    say "FAIL: previous companion load did not complete; run 'omanome companion disable' or rebuild before enabling"
    failed=1
  fi
  if [[ -f "$companion_lifecycle_file" ]]; then
    say "Last event: $(jq -r '.lastEvent // "unknown"' "$companion_lifecycle_file" 2>/dev/null || printf 'unknown') at $(jq -r '.lastEventAt // "unknown"' "$companion_lifecycle_file" 2>/dev/null || printf 'unknown')"
    say "Crash count: $(jq -r '.crashCount // 0' "$companion_lifecycle_file" 2>/dev/null || printf '0')"
    say "Load failures: $(jq -r '.loadFailureCount // 0' "$companion_lifecycle_file" 2>/dev/null || printf '0')"
  fi
  if [[ -f "$omanome_config_dir/safe-mode" ]]; then
    say "WARN: Omanome safe mode marker disables companion loading"
  fi
  return "$failed"
}

companion_build_cmd() {
  [[ -d "$companion_root" ]] || die "companion source is missing"
  if ! make -C "$companion_root" all; then
    say "Companion build failed without changing the running compositor."
    say "Install the printed development dependencies with your normal package manager; Omanome never invokes sudo."
    return 2
  fi
  say "Built $companion_root/build/omanome-hypr.so"
}

companion_install_cmd() {
  companion_build_cmd
  mkdir -p -- "$companion_data_dir"
  local previous_backup=""
  previous_backup="$(companion_backup_artifact || true)"
  install -Dm755 -- "$companion_root/build/omanome-hypr.so" "$companion_artifact"
  install -Dm644 -- "$companion_manifest" "$companion_data_dir/compatibility.json"
  local runtime_version runtime_abi runtime_commit compiler artifact_hash plugin_build metadata
  runtime_version="$(companion_runtime_version || true)"
  runtime_abi="$(companion_runtime_abi || true)"
  runtime_commit="$(companion_runtime_commit || true)"
  compiler="$(g++ --version 2>/dev/null | head -n 1 || true)"
  artifact_hash="$(sha256sum "$companion_artifact" | awk '{print $1}')"
  plugin_build="$(manifest_value version)"
  metadata="$companion_data_dir/compatibility.json.tmp"
  jq --arg version "${runtime_version:-unknown}" \
    --arg commit "${runtime_commit:-unknown}" \
    --arg abi "${runtime_abi:-unknown}" \
    --arg compiler "${compiler:-unknown}" \
    --arg pluginBuild "$plugin_build" \
    --arg artifactHash "$artifact_hash" \
    --arg builtAt "$(companion_timestamp)" \
    '. + {
      hyprland:{version:$version,commit:$commit,abi:$abi},
      build:{hyprlandVersion:$version,hyprlandCommit:$commit,hyprlandAbi:$abi,compiler:$compiler,pluginBuild:$pluginBuild,artifactSha256:$artifactHash,builtAt:$builtAt}
    }' \
    "$companion_data_dir/compatibility.json" >"$metadata"
  mv -f -- "$metadata" "$companion_data_dir/compatibility.json"
  chmod 600 -- "$companion_data_dir/compatibility.json"
  rm -f -- "$companion_pending_marker"
  companion_state_update artifact-installed "new artifact installed${previous_backup:+; previous artifact backed up}"
  say "Installed user-owned companion at $companion_artifact"
  [[ -z "$previous_backup" ]] || say "Previous artifact backed up at $previous_backup"
  say "No compositor module was loaded; run 'omanome companion enable' explicitly after reviewing the artifact."
}

companion_rebuild_cmd() {
  companion_install_cmd
}

companion_enable_cmd() {
  local force=0
  for argument in "$@"; do [[ "$argument" == "--force" ]] && force=1; done
  ensure_dirs
  [[ ! -f "$omanome_config_dir/safe-mode" ]] || die "Omanome safe mode is active; run 'omanome enable' first"
  if [[ -f "$companion_pending_marker" && "$force" -ne 1 ]]; then
    die "previous companion load did not complete; run 'omanome companion recover' or explicitly acknowledge with 'omanome companion enable --force'"
  fi
  if [[ -f "$companion_pending_marker" && "$force" -eq 1 ]]; then
    say "WARNING: explicitly overriding the previous load-pending marker"
    rm -f -- "$companion_pending_marker"
    companion_state_update crash-detected "explicit enable --force override"
  fi
  [[ -f "$companion_artifact" ]] || die "companion is not installed; run 'omanome companion install'"
  if ! companion_doctor_cmd; then
    die "companion is not compatible with the running Hyprland"
  fi
  has hyprctl || die "hyprctl is unavailable"
  mkdir -p -- "$companion_state_dir"
  rm -f -- "$companion_disabled_marker"
  : >"$companion_pending_marker"
  chmod 600 -- "$companion_pending_marker"
  companion_state_update load-attempt "explicit load requested"
  if ! hyprctl plugin load "$companion_artifact"; then
    companion_state_update load-failure "hyprctl plugin load failed"
    say "Companion load failed; marker kept so the next startup will not retry it automatically."
    return 1
  fi
  if ! hyprctl plugins list 2>/dev/null | grep -Fq 'omanome-hypr'; then
    companion_state_update load-failure "plugin load was not visible in Hyprland"
    say "Companion load was not confirmed; marker kept and the core remains usable."
    return 1
  fi
  local status
  status="$(hyprctl -j omanome-effects 2>/dev/null || true)"
  if ! jq -e '.protocolVersion == 2 and .loaded == true and .api.hashMatch == true' >/dev/null 2>&1 <<<"$status"; then
    companion_state_update load-failure "versioned status IPC did not confirm a compatible load"
    say "Companion status IPC was not compatible; marker kept and advanced effects remain disabled."
    return 1
  fi
  rm -f -- "$companion_pending_marker"
  companion_state_update load-success "versioned status IPC confirmed the loaded companion"
  say "Requested load of the version-matched Omanome companion."
}

companion_disable_cmd() {
  ensure_dirs
  : >"$companion_disabled_marker"
  chmod 600 -- "$companion_disabled_marker"
  local unload_failed=0
  if has hyprctl && [[ -f "$companion_artifact" ]]; then
    if hyprctl plugins list 2>/dev/null | grep -Fq 'omanome-hypr'; then
      hyprctl plugin unload "$companion_artifact" >/dev/null 2>&1 || unload_failed=1
    fi
  fi
  rm -f -- "$companion_pending_marker"
  companion_state_update disabled "explicit disable requested"
  if [[ "$unload_failed" -eq 1 ]]; then
    say "Omanome companion marked disabled for the next session; runtime unload was rejected by Hyprland."
    return 1
  fi
  say "Omanome companion disabled; advanced effects remain fail-closed."
}

companion_recover_cmd() {
  ensure_dirs
  companion_disable_cmd || true
  local latest_backup
  latest_backup="$(find "$companion_backup_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | tail -n 1)"
  if [[ -n "$latest_backup" && -f "$companion_backup_dir/$latest_backup/omanome-hypr.so" ]]; then
    mkdir -p -- "$companion_data_dir"
    install -Dm755 -- "$companion_backup_dir/$latest_backup/omanome-hypr.so" "$companion_artifact"
    if [[ -f "$companion_backup_dir/$latest_backup/compatibility.json" ]]; then
      install -Dm600 -- "$companion_backup_dir/$latest_backup/compatibility.json" "$companion_data_dir/compatibility.json"
    fi
    say "Restored previous companion artifact from $latest_backup"
  else
    say "No previous companion artifact backup was available; companion remains disabled."
  fi
  rm -f -- "$companion_pending_marker"
  companion_state_update recovered "explicit recovery requested"
  say "Companion recovery complete; automatic loading remains disabled."
}

setup_cmd() {
  ensure_dirs
  chmod +x -- "$repo_dir/cli/omanome" "$repo_dir/input/clipboard-capture.sh" "$repo_dir/input/sensor-info.sh" "$repo_dir/input/companion-info.sh" "$repo_dir/input/effects-info.sh" 2>/dev/null || true
  cat <<'EOF'
Omanome setup is user-only and never invokes sudo.

Required runtime:
  omarchy (Quattro), quickshell, Hyprland, wl-paste/wl-copy, wtype

  Optional integrations:
  nmcli          Wi-Fi/airplane actions
  bluetoothctl   Bluetooth actions
  brightnessctl  brightness slider
  grim           screenshots
  wf-recorder    screen recording hook
  iio-sensor-proxy / a compositor sensor bridge for auto-rotation
  Hyprland development headers/pkg-config for the optional omanome-hypr companion

The companion is never built or loaded by the core install. Use explicit commands:
  omanome companion doctor
  omanome companion build
  omanome companion install
  omanome companion enable

Install missing packages with your normal package manager, then run:
  omarchy plugin add https://github.com/pluseight8/omanome.git --enable --yes
  omanome doctor
EOF
}

install_cmd() {
  has omarchy || die "omarchy is not installed"
  if [[ -d "$installed_plugin_dir" ]]; then
    say "Omanome is already installed at $installed_plugin_dir"
    omarchy plugin enable "$plugin_id"
    reload_cmd || true
    return 0
  fi
  # Delegate cloning, manifest validation, enablement, and shell registration
  # to Omarchy's official plugin manager. This never edits OMARCHY_PATH and
  # never needs sudo.
  omarchy plugin add "$repository_url" --enable --yes
}

export_cmd() {
  ensure_dirs
  local output="${1:-}"
  local current
  current="$(config_file)"
  if [[ ! -f "$current" ]]; then cp -- "$repo_dir/config/defaults.json" "$current"; fi
  if [[ -n "$output" ]]; then
    install -Dm600 -- "$current" "$output"
  else
    cat -- "$current"
  fi
}

import_cmd() {
  [[ $# -eq 1 ]] || die "import-config requires a JSON file"
  local input="$1"
  [[ -f "$input" ]] || die "config file not found: $input"
  jq -e '.schemaVersion == 1' "$input" >/dev/null || die "config must contain schemaVersion: 1"
  ensure_dirs
  backup_config
  install -Dm600 -- "$input" "$(config_file)"
  if has omarchy-shell; then omarchy-shell -q "$plugin_id" reload || true; fi
}

reset_cmd() {
  local accept=0
  [[ "${1:-}" == "--yes" ]] && accept=1
  if [[ "$accept" -ne 1 ]]; then
    read -r -p "Reset only Omanome settings? [y/N] " answer
    [[ "$answer" == "y" || "$answer" == "Y" ]] || exit 0
  fi
  ensure_dirs
  backup_config
  install -Dm600 -- "$repo_dir/config/defaults.json" "$(config_file)"
  if has omarchy-shell; then omarchy-shell -q "$plugin_id" reload || true; fi
}

installed_version() {
  if [[ -f "$installed_plugin_dir/manifest.json" ]]; then jq -r '.version // "unknown"' "$installed_plugin_dir/manifest.json"; else printf 'not-installed\n'; fi
}

normalize_repository_url() {
  local value="${1:-}"
  value="${value%/}"
  value="${value%.git}"
  printf '%s\n' "$value"
}

repository_version() {
  local raw version
  if ! has curl || ! raw="$(curl -fsSL --max-time 8 "$repository_manifest_url" 2>/dev/null)"; then
    printf 'unavailable\n'
    return 0
  fi
  version="$(printf '%s' "$raw" | jq -r '.version // empty' 2>/dev/null || true)"
  [[ -n "$version" ]] && printf '%s\n' "$version" || printf 'unavailable\n'
}

current_update_channel() {
  local current
  current="$(config_file)"
  if [[ -f "$current" ]]; then
    jq -r '.updates.channel // "stable"' "$current" 2>/dev/null || printf 'stable\n'
  else
    printf 'stable\n'
  fi
}

installed_commit() {
  if [[ -d "$installed_plugin_dir/.git" ]]; then
    git -C "$installed_plugin_dir" rev-parse HEAD 2>/dev/null || printf 'unavailable\n'
  else
    printf 'unavailable\n'
  fi
}

remote_commit() {
  local commit
  commit="$(git ls-remote "$repository_url" refs/heads/main 2>/dev/null | awk 'NR == 1 { print $1 }')"
  [[ -n "$commit" ]] && printf '%s\n' "$commit" || printf 'unavailable\n'
}

check_update_cmd() {
  say "Installed version: $(installed_version)"
  say "Latest repository version: $(repository_version)"
  say "Current update channel: $(current_update_channel)"
  local current="unavailable"
  local remote="unavailable"
  local available="unknown"
  if [[ -d "$installed_plugin_dir/.git" ]]; then
    say "Git remote: $(git -C "$installed_plugin_dir" remote get-url origin 2>/dev/null || printf 'none')"
    current="$(installed_commit)"
    remote="$(remote_commit)"
    if [[ "$current" != "unavailable" && "$remote" != "unavailable" ]]; then
      [[ "$current" == "$remote" ]] && available="no" || available="yes"
    fi
  else
    say "No installed git checkout found"
  fi
  say "Current commit: $current"
  say "Remote commit: $remote"
  say "Update available: $available"
  say "Hyprland: $(hyprctl version 2>/dev/null | head -n 1 || printf 'unavailable')"
  say "Quickshell: $(quickshell --version 2>/dev/null | head -n 1 || printf 'unavailable')"
}

ensure_repository_remote() {
  [[ -d "$installed_plugin_dir/.git" ]] || die "installed Omanome checkout not found"
  local configured normalized expected
  configured="$(git -C "$installed_plugin_dir" remote get-url origin 2>/dev/null || true)"
  normalized="$(normalize_repository_url "$configured")"
  expected="$(normalize_repository_url "$repository_url")"
  [[ "$normalized" == "$expected" ]] || die "installed checkout origin is '$configured'; expected '$repository_url'"
}

create_rollback_cmd() {
  [[ -d "$installed_plugin_dir" ]] || die "installed Omanome checkout not found"
  ensure_dirs
  local stamp="$rollback_dir/$(date +%Y%m%d-%H%M%S)"
  mkdir -p -- "$stamp"
  cp -a -- "$installed_plugin_dir" "$stamp/plugin"
  if [[ -f "$(config_file)" ]]; then cp -p -- "$(config_file)" "$stamp/config.json"; fi
  if [[ -d "$companion_data_dir" ]]; then cp -a -- "$companion_data_dir" "$stamp/companion"; fi
  if [[ -d "$companion_state_dir" ]]; then cp -a -- "$companion_state_dir" "$stamp/companion-state"; fi
  printf '%s\n' "$stamp"
}

restore_latest_cmd() {
  local snapshot
  snapshot="$(find "$rollback_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | tail -n 1)"
  [[ -n "$snapshot" && -d "$rollback_dir/$snapshot/plugin" ]] || die "no rollback point available"
  local failed_dir="${installed_plugin_dir}.failed.$(date +%s)"
  if [[ -e "$failed_dir" ]]; then failed_dir="${installed_plugin_dir}.failed.$(date +%s%N)"; fi
  if [[ -d "$installed_plugin_dir" ]]; then mv -- "$installed_plugin_dir" "$failed_dir"; fi
  cp -a -- "$rollback_dir/$snapshot/plugin" "$installed_plugin_dir"
  if [[ -f "$rollback_dir/$snapshot/config.json" ]]; then cp -p -- "$rollback_dir/$snapshot/config.json" "$(config_file)"; fi
  if [[ -d "$rollback_dir/$snapshot/companion" ]]; then
    if [[ -d "$companion_data_dir" ]]; then mv -- "$companion_data_dir" "${companion_data_dir}.failed.$(date +%s)"; fi
    cp -a -- "$rollback_dir/$snapshot/companion" "$companion_data_dir"
  fi
  if [[ -d "$rollback_dir/$snapshot/companion-state" ]]; then
    if [[ -d "$companion_state_dir" ]]; then mv -- "$companion_state_dir" "${companion_state_dir}.failed.$(date +%s)"; fi
    cp -a -- "$rollback_dir/$snapshot/companion-state" "$companion_state_dir"
  fi
  say "Restored rollback point $snapshot"
}

update_cmd() {
  if [[ "${1:-}" == "--check" ]]; then check_update_cmd; return; fi
  has omarchy || die "omarchy is not installed"
  ensure_repository_remote
  create_rollback_cmd >/dev/null
  if ! omarchy plugin update "$plugin_id" --yes; then
    say "Update failed; restoring the previous checkout."
    restore_latest_cmd
    return 1
  fi
  if ! omarchy plugin validate "$installed_plugin_dir" >/dev/null 2>&1; then
    say "Updated checkout failed validation; restoring the previous checkout."
    restore_latest_cmd
    return 1
  fi
  reload_cmd || true
  say "Omanome updated; rollback point kept under $rollback_dir"
}

rollback_cmd() {
  restore_latest_cmd
  reload_cmd || true
}

uninstall_cmd() {
  local purge=0
  local accept=0
  for arg in "$@"; do
    [[ "$arg" == "--purge-settings" ]] && purge=1
    [[ "$arg" == "--yes" ]] && accept=1
  done
  if [[ "$accept" -ne 1 ]]; then
    read -r -p "Remove the Omanome plugin and its optional companion data? [y/N] " answer
    [[ "$answer" == "y" || "$answer" == "Y" ]] || exit 0
    read -r -p "Keep Omanome settings? [Y/n] " keep
    [[ "$keep" == "n" || "$keep" == "N" ]] && purge=1
  fi
  if has omarchy; then omarchy plugin remove "$plugin_id" --yes || true; fi
  if [[ -d "$installed_plugin_dir" ]]; then rm -rf -- "$installed_plugin_dir"; fi
  rm -rf -- "$omanome_state_dir" "$omanome_cache_dir"
  if [[ "$purge" -eq 1 ]]; then rm -rf -- "$omanome_config_dir"; else rm -f -- "$omanome_config_dir/safe-mode"; fi
  say "Omanome removed. Omarchy, its standard bar, other plugins, themes, and user Hyprland configuration were not touched."
}

devices_cmd() {
  has hyprctl || die "hyprctl is not installed"
  hyprctl devices -j | jq .
}

stylus_info_cmd() {
  has hyprctl || die "hyprctl is not installed"
  hyprctl devices -j | jq '{tablets: (.tablets // .tabletTools // []), touchDevices: (.touch // .touchDevices // [])}'
}

touch_info_cmd() {
  has hyprctl || die "hyprctl is not installed"
  hyprctl devices -j | jq '{touchDevices: (.touch // .touchDevices // .touchdevices // [])}'
}

sensor_info_cmd() {
  [[ -x "$repo_dir/input/sensor-info.sh" ]] || die "sensor-info backend is unavailable"
  "$repo_dir/input/sensor-info.sh" | jq .
}

effects_cmd() {
  [[ -x "$repo_dir/input/effects-info.sh" ]] || die "effect diagnostics are unavailable"
  "$repo_dir/input/effects-info.sh" | jq .
}

benchmark_cmd() {
  local layers="unavailable"
  local clients="unavailable"
  if has hyprctl; then
    layers="$(hyprctl layers 2>/dev/null | awk '/namespace:/ { count++ } END { print count + 0 }')"
    clients="$(hyprctl clients -j 2>/dev/null | jq 'length' 2>/dev/null || printf 'unavailable')"
  fi
  jq -n \
    --arg version "$(manifest_value version)" \
    --arg quickshell "$(quickshell --version 2>/dev/null | head -n 1 || printf 'unavailable')" \
    --arg hyprland "$(hyprctl version 2>/dev/null | head -n 1 || printf 'unavailable')" \
    --arg layers "$layers" \
    --arg clients "$clients" \
    '{version:$version,quickshell:$quickshell,hyprland:$hyprland,layerCount:($layers|tonumber? // null),clientCount:($clients|tonumber? // null),method:"snapshot only; no per-frame polling"}'
}

version_cmd() { manifest_value version; }

command_name="${1:-}"
shift || true
case "$command_name" in
  status) status_cmd "$@" ;;
  doctor) doctor_cmd "$@" ;;
  logs) logs_cmd "$@" ;;
  reload) reload_cmd "$@" ;;
  enable) enable_cmd "$@" ;;
  disable) disable_cmd "$@" ;;
  safe-mode) safe_mode_cmd "$@" ;;
  setup) setup_cmd "$@" ;;
  install) install_cmd "$@" ;;
  export-config) export_cmd "$@" ;;
  import-config) import_cmd "$@" ;;
  reset) reset_cmd "$@" ;;
  update) update_cmd "$@" ;;
  rollback) rollback_cmd "$@" ;;
  uninstall) uninstall_cmd "$@" ;;
  devices) devices_cmd "$@" ;;
  stylus-info) stylus_info_cmd "$@" ;;
  touch-info) touch_info_cmd "$@" ;;
  sensor-info) sensor_info_cmd "$@" ;;
  effects) effects_cmd "$@" ;;
  benchmark) benchmark_cmd "$@" ;;
  companion)
    companion_command="${1:-status}"
    shift || true
    case "$companion_command" in
      status) companion_info_cmd "$@" ;;
      doctor) companion_doctor_cmd "$@" ;;
      build) companion_build_cmd "$@" ;;
      install) companion_install_cmd "$@" ;;
      rebuild) companion_rebuild_cmd "$@" ;;
      enable) companion_enable_cmd "$@" ;;
      disable) companion_disable_cmd "$@" ;;
      recover) companion_recover_cmd "$@" ;;
      *) usage >&2; die "unknown companion command: $companion_command" ;;
    esac
    ;;
  version) version_cmd "$@" ;;
  help|-h|--help|"") usage ;;
  *) usage >&2; die "unknown command: $command_name" ;;
esac
